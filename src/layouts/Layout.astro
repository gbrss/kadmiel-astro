---
import '../styles/global.css';
import fontUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description = "Kadmiel - Páginas Web Ultrarrápidas con Astro JS.", image = '/og-image.jpg' } = Astro.props;
const site = 'https://kadmiel.cl';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#090d16" />
		<link rel="canonical" href={canonical} />

		<!-- Íconos (PNG para WhatsApp/iOS/Android, SVG para navegadores modernos) -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<!-- Vista previa al compartir (WhatsApp, Facebook, LinkedIn, X) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Kadmiel" />
		<meta property="og:locale" content="es_CL" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Kadmiel — Sitios web ultrarrápidos para tu negocio" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Precarga de la fuente local -->
		<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
	</head>
	<body class="bg-kadmiel-bg text-slate-100 font-sans antialiased selection:bg-purple-500 selection:text-white">
		<slot />
		
		<script>
			// Reveal al scroll (excluye el Hero para no afectar el LCP)
			const targets = document.querySelectorAll(
				'main > section:not(:first-child), footer, .reveal, #ventajas > div > div > div, #comparativa table'
			);

			targets.forEach((el) => el.classList.add('fade-section'));

			const io = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
			);

			document.querySelectorAll('.fade-section').forEach((el) => io.observe(el));

			// Navegación por anclas compatible con content-visibility:auto.
			// Al primer gesto del usuario se renderizan todas las secciones (no afecta la carga
			// medida por PageSpeed), así el salto se calcula con alturas reales y no hay correcciones.
			const root = document.documentElement;
			const renderAll = () => root.classList.add('cv-off');
			['pointerdown', 'touchstart', 'keydown', 'wheel', 'scroll'].forEach((ev) =>
				window.addEventListener(ev, renderAll, { passive: true, once: true, capture: true })
			);

			// Posición absoluta sin transforms (las animaciones de entrada desplazan con translateY)
			const targetY = (el: HTMLElement) => {
				let y = 0;
				for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) y += n.offsetTop;
				return Math.max(0, y - parseFloat(getComputedStyle(el).scrollMarginTop || '0'));
			};

			const goToHash = (hash: string, smooth: boolean) => {
				const target = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
				if (!target) return false;
				renderAll();
				void root.offsetHeight; // fuerza el layout ya con todas las secciones renderizadas
				const behavior: ScrollBehavior = smooth ? 'smooth' : 'instant';
				const y = targetY(target);
				window.scrollTo({ top: y, behavior });
				// Corrección única y suave solo si algo cambió de alto durante el scroll
				let done = false;
				const check = () => {
					if (done) return;
					done = true;
					const y2 = targetY(target);
					if (Math.abs(y2 - y) > 2 || Math.abs(window.scrollY - y2) > 2) window.scrollTo({ top: y2, behavior });
				};
				if (smooth && 'onscrollend' in window) {
					window.addEventListener('scrollend', check, { once: true });
					setTimeout(check, 1500);
				} else {
					setTimeout(check, smooth ? 900 : 50);
				}
				return true;
			};

			document.addEventListener('click', (e) => {
				if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				const link = (e.target as Element | null)?.closest?.('a[href^="#"]') as HTMLAnchorElement | null;
				if (!link) return;
				const hash = link.getAttribute('href') || '';
				if (hash === '#') return;
				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (goToHash(hash, !reduce)) {
					e.preventDefault();
					if (location.hash !== hash) history.pushState(null, '', hash);
				}
			});

			// Si se entra directo con un ancla (ej. kadmiel.cl/#cotizador) o se usa atrás/adelante
			if (location.hash) {
				if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
				goToHash(location.hash, false);
				window.addEventListener('load', () => goToHash(location.hash, false), { once: true });
			}
			window.addEventListener('popstate', () => { if (location.hash) goToHash(location.hash, false); });
		</script>
	</body>
</html>

<style is:global>
	::-webkit-scrollbar { width: 10px; }
	::-webkit-scrollbar-track { background: #090d16; }
	::-webkit-scrollbar-thumb { background: #1f2937; border-radius: 5px; }
	::-webkit-scrollbar-thumb:hover { background: #374151; }

	.fade-section {
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}
	.fade-section.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Secciones fuera de pantalla: el navegador omite estilo/layout/paint hasta que se acercan al viewport.
	   (#proceso se excluye porque sus popovers sobresalen de las tarjetas) */
	main > section:not(:first-child):not(#proceso),
	body > footer {
		content-visibility: auto;
		contain-intrinsic-size: auto 900px;
	}
	/* Al navegar a un ancla se desactiva para que el salto calcule alturas reales */
	html.cv-off main > section:not(:first-child):not(#proceso),
	html.cv-off body > footer {
		content-visibility: visible;
	}
	/* Compensa el header fijo (h-20) al saltar a un ancla */
	main > section[id] {
		scroll-margin-top: 5rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.fade-section {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
		}
	}
</style>