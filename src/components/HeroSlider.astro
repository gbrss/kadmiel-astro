---
// Ya no importamos PageSpeedCard aquí
---
<section class="relative min-h-screen pt-24 pb-20 flex items-center overflow-hidden bg-kadmiel-bg">
  
  <!-- Fondo de rejilla -->
  <div class="absolute inset-0 z-0 pointer-events-none opacity-20" 
       style="background-image: linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px); background-size: 50px 50px; mask-image: radial-gradient(ellipse 80% 50% at 50% 0%, #000 70%, transparent 100%);">
  </div>

  <!-- Canvas para la animación de partículas -->
  <canvas id="hero-canvas" aria-hidden="true" class="absolute inset-0 z-0 pointer-events-none w-full h-full"></canvas>

  <!-- Halos de luz -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-200 h-125 pointer-events-none z-0" 
       style="background: radial-gradient(closest-side, rgba(139,92,246,0.15) 0%, rgba(139,92,246,0.06) 55%, transparent 100%);"></div>
  <div class="absolute top-40 right-0 w-112.5 h-112.5 pointer-events-none z-0" aria-hidden="true" 
       style="background: radial-gradient(closest-side, rgba(6,182,212,0.1) 0%, rgba(6,182,212,0.04) 55%, transparent 100%);"></div>

  <div class="max-w-7xl mx-auto px-6 w-full grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center relative z-10">
    
    <!-- Columna izquierda: copy comercial -->
    <div class="lg:col-span-7 space-y-8">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-bold uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        +40 sitios entregados · 100/100 PageSpeed
      </div>

      <!-- H1 Optimizado para detección inmediata de LCP -->
      <h1 
        class="text-5xl sm:text-6xl md:text-7xl font-extrabold leading-[1.1] tracking-tight text-white"
      >
        Tu web en <span class="text-cyan-400">menos de 1 segundo</span>
        <span class="block mt-2 text-slate-200">o pierdes clientes cada día</span>
      </h1>

      <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-xl">
        En <strong class="text-white">Kadmiel</strong> construimos sitios con <strong class="text-cyan-300">Astro</strong> que cargan al instante, posicionan mejor en Google y convierten más visitas en ventas. Sin plugins lentos. Sin WordPress frágil.
      </p>

      <!-- Beneficios clave en bullets -->
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-base">
        <li class="flex items-start gap-3 text-slate-200">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-sm font-bold">✓</span>
          <span>Carga &lt; 0.8 s en móvil y PC</span>
        </li>
        <li class="flex items-start gap-3 text-slate-200">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-sm font-bold">✓</span>
          <span>Score 95–100 en PageSpeed</span>
        </li>
        <li class="flex items-start gap-3 text-slate-200">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-sm font-bold">✓</span>
          <span>SEO listo desde el día 1</span>
        </li>
        <li class="flex items-start gap-3 text-slate-200">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-sm font-bold">✓</span>
          <span>Entrega en 7–15 días hábiles</span>
        </li>
      </ul>

      <!-- CTAs principales -->
      <div class="flex flex-wrap gap-4 pt-2">
        <a
          href="#cotizador"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-linear-to-r from-violet-600 via-indigo-600 to-cyan-500 text-white font-extrabold text-lg shadow-xl shadow-violet-600/35 hover:scale-[1.03] hover:shadow-cyan-500/30 transition-all"
        >
          Cotizar mi proyecto
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a
          href="#proceso"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl border border-slate-700 bg-slate-900/60 text-slate-200 font-bold text-lg hover:border-cyan-500/50 hover:text-white transition-all"
        >
          Cómo trabajamos
        </a>
      </div>

      <!-- Micro-prueba social -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-4 text-sm text-slate-400">
        <span class="flex items-center gap-1.5">
          <span class="text-amber-400 text-lg">★★★★★</span>
          <span>Clientes pymes y startups</span>
        </span>
        <span class="hidden sm:inline text-slate-600">·</span>
        <span>Soporte post-entrega incluido</span>
      </div>
    </div>

    <!-- Columna derecha: SÚPER TARJETA DE OFERTA -->
    <div class="lg:col-span-5 relative z-20 mt-10 lg:mt-0">
      
      <!-- Contenedor con animación de borde -->
      <a href="#cotizador" class="relative block rounded-4xl p-0.75 overflow-hidden group hover:scale-[1.02] transition-transform duration-300 shadow-2xl">
        
        <!-- Luz giratoria del borde -->
        <div aria-hidden="true" class="absolute -inset-full motion-safe:animate-[spin_4s_linear_infinite] will-change-transform bg-[conic-gradient(from_0deg,transparent_0%,transparent_60%,#8b5cf6_85%,#22d3ee_100%)]"></div>

        <!-- Cuerpo de la tarjeta -->
        <div class="relative bg-[#0d1322] h-full w-full rounded-[calc(2rem-3px)] p-8 md:p-10 flex flex-col border border-slate-800/50 overflow-hidden">
          
          <div class="absolute top-0 right-0 w-64 h-64 pointer-events-none rounded-full" style="background: radial-gradient(closest-side, rgba(139,92,246,0.15) 0%, rgba(139,92,246,0.06) 55%, transparent 100%);"></div>

          <div class="absolute top-0 right-8 bg-linear-to-r from-violet-600 to-cyan-500 text-white text-xs font-black px-4 py-1.5 rounded-b-lg uppercase tracking-wider shadow-lg z-10 animate-pulse">
            Oferta Especial
          </div>

          <div class="w-16 h-16 rounded-2xl bg-violet-500/20 flex items-center justify-center text-violet-400 mb-6 border border-violet-500/30 shadow-[0_0_20px_rgba(139,92,246,0.3)]">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>

          <h2 class="text-3xl font-black text-white leading-tight mb-3">
            Promoción <br/> Pyme Sitio Web
          </h2>
          <p class="text-slate-400 text-sm mb-8 leading-relaxed">
            Todo lo que necesitas para digitalizar tu negocio hoy. Sin letra chica.
          </p>

          <div class="bg-slate-950/60 rounded-2xl p-5 border border-slate-800 mb-8 relative overflow-hidden">
            <div class="absolute inset-0 bg-linear-to-r from-violet-500/5 to-cyan-500/5"></div>
            
            <div class="flex items-end justify-between relative z-10">
              <div>
                <p class="text-xs text-slate-500 font-bold uppercase tracking-widest mb-1">Pago Inicial</p>
                <p class="text-4xl font-black text-transparent bg-clip-text bg-linear-to-r from-violet-400 to-cyan-400">
                  $45.990
                </p>
              </div>
              <div class="text-right pb-1">
                <p class="text-sm font-bold text-violet-300">+ $25.000<span class="text-xs text-slate-500 font-normal">/mes</span></p>
              </div>
            </div>
          </div>

          <ul class="space-y-4 mb-8 flex-1">
            <li class="flex items-center gap-3 text-sm text-slate-300 font-medium">
              <div class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </div>
              Dominio incluido (1 año)
            </li>
            <li class="flex items-center gap-3 text-sm text-slate-300 font-medium">
              <div class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </div>
              Primer mes de hosting gratis
            </li>
            <li class="flex items-center gap-3 text-sm text-slate-300 font-medium">
              <div class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </div>
              Diseño 100% responsive
            </li>
            <li class="flex items-center gap-3 text-sm text-slate-300 font-medium">
              <div class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </div>
              Optimización SEO base
            </li>
          </ul>

          <div class="w-full py-4 rounded-xl bg-violet-600 group-hover:bg-violet-500 text-center text-white font-black text-lg transition-colors shadow-lg shadow-violet-600/20">
            ¡Quiero esta oferta!
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<script>
  const initCanvas = () => {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    let width = 0, height = 0;
    const resize = () => {
      width = canvas.width = canvas.offsetWidth;
      height = canvas.height = canvas.offsetHeight;
    };
    resize();
    let resizeRaf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(resize);
    }, { passive: true });

    const particles: { x: number, y: number, vx: number, vy: number, radius: number, color: string }[] = [];
    const particleCount = window.innerWidth < 768 ? 20 : 60;
    const maxDistance = 120;
    const maxDist2 = maxDistance * maxDistance;

    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
        radius: Math.random() * 1.2 + 0.8,
        color: Math.random() > 0.5 ? 'rgba(34, 211, 238, 0.5)' : 'rgba(139, 92, 246, 0.5)'
      });
    }

    let rafId = 0;
    let running = false;

    function frame() {
      ctx!.clearRect(0, 0, width, height);

      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx!.fillStyle = p.color;
        ctx!.fill();
      }

      ctx!.lineWidth = 1;
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const d2 = dx * dx + dy * dy;
          if (d2 < maxDist2) {
            const opacity = 1 - Math.sqrt(d2) / maxDistance;
            ctx!.beginPath();
            ctx!.moveTo(particles[i].x, particles[i].y);
            ctx!.lineTo(particles[j].x, particles[j].y);
            ctx!.strokeStyle = `rgba(139, 92, 246, ${opacity * 0.25})`;
            ctx!.stroke();
          }
        }
      }
      if (running) rafId = requestAnimationFrame(frame);
    }

    const start = () => { if (!running && !document.hidden) { running = true; rafId = requestAnimationFrame(frame); } };
    const stop = () => { running = false; cancelAnimationFrame(rafId); };

    // Solo anima mientras el hero está en pantalla y la pestaña visible
    let inView = true;
    new IntersectionObserver(([e]) => { inView = e.isIntersecting; inView ? start() : stop(); }).observe(canvas);
    document.addEventListener('visibilitychange', () => { document.hidden ? stop() : inView && start(); });
    start();
  };

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Se inicia después del load, en tiempo ocioso: no compite con LCP ni suma TBT
    let loaded = false;
    const boot = () => {
      if (loaded) return;
      loaded = true;
      const ric = (window as any).requestIdleCallback as ((cb: () => void, o?: { timeout: number }) => number) | undefined;
      ric ? ric(initCanvas, { timeout: 2000 }) : setTimeout(initCanvas, 200);
    };
    window.addEventListener('scroll', boot, { passive: true, once: true });
    window.addEventListener('pointerdown', boot, { passive: true, once: true });
    window.addEventListener('load', () => setTimeout(boot, 3500), { once: true });
  }
</script>
