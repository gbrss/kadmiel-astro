---
import PageSpeedCard from './PageSpeedCard.astro';
---
<section class="relative min-h-screen pt-24 pb-20 flex items-center overflow-hidden bg-gradient-to-b from-[#090d16] via-[#0d1322] to-[#090d16]">
  <!-- Fondos decorativos -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-violet-600/15 rounded-full blur-[160px] pointer-events-none"></div>
  <div class="absolute top-1/3 right-0 w-[450px] h-[450px] bg-cyan-500/10 rounded-full blur-[130px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-indigo-600/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 w-full grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center relative z-10">
    <!-- Columna izquierda: copy comercial -->
    <div class="lg:col-span-7 space-y-7">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-bold uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        +40 sitios entregados · 100/100 PageSpeed
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white leading-[1.1] tracking-tight">
        Tu web en
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 via-cyan-400 to-emerald-300">menos de 1 segundo</span>
        <span class="block mt-1 text-slate-200">o pierdes clientes cada día</span>
      </h1>

      <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-xl">
        En <strong class="text-white">Kadmiel</strong> construimos sitios con <strong class="text-cyan-300">Astro</strong> que cargan al instante, posicionan mejor en Google y convierten más visitas en ventas. Sin plugins lentos. Sin WordPress frágil.
      </p>

      <!-- Beneficios clave en bullets -->
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        <li class="flex items-start gap-2.5 text-slate-200">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold">✓</span>
          <span>Carga &lt; 0.8 s en móvil y PC</span>
        </li>
        <li class="flex items-start gap-2.5 text-slate-200">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold">✓</span>
          <span>Score 95–100 en Google PageSpeed</span>
        </li>
        <li class="flex items-start gap-2.5 text-slate-200">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold">✓</span>
          <span>SEO listo desde el día 1</span>
        </li>
        <li class="flex items-start gap-2.5 text-slate-200">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold">✓</span>
          <span>Entrega en 7–15 días hábiles</span>
        </li>
      </ul>

      <!-- CTAs principales -->
      <div class="flex flex-wrap gap-3 pt-1">
        <a
          href="#cotizador"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-gradient-to-r from-violet-600 via-indigo-600 to-cyan-500 text-white font-extrabold text-base shadow-xl shadow-violet-600/35 hover:scale-[1.03] hover:shadow-cyan-500/30 transition-all"
        >
          Cotizar mi proyecto
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a
          href="#proceso"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border border-slate-700 bg-slate-900/60 text-slate-200 font-semibold text-base hover:border-cyan-500/50 hover:text-white transition-all"
        >
          Cómo trabajamos
        </a>
      </div>

      <!-- Micro-prueba social -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-2 text-xs text-slate-400">
        <span class="flex items-center gap-1.5">
          <span class="text-amber-400">★★★★★</span>
          <span>Clientes pymes y startups</span>
        </span>
        <span class="hidden sm:inline text-slate-600">·</span>
        <span>Sin mensualidades ocultas</span>
        <span class="hidden sm:inline text-slate-600">·</span>
        <span>Soporte post-entrega incluido</span>
      </div>
    </div>

    <!-- Columna derecha: PageSpeed (se mantiene) -->
    <div class="lg:col-span-5">
      <PageSpeedCard score={100} />
      <p class="mt-4 text-center text-xs text-slate-500">
        Ejemplo real de rendimiento que apuntamos en cada proyecto Kadmiel.
      </p>
    </div>
  </div>
</section>
