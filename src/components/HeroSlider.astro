---
---
<section class="relative min-h-screen pt-28 pb-16 flex items-center overflow-hidden bg-gradient-to-b from-[#090d16] via-[#0d1322] to-[#090d16]">
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-violet-600/15 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-[400px] h-[400px] bg-cyan-500/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
    <div class="lg:col-span-7 space-y-8">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-violet-500/10 border border-violet-500/30 text-violet-300 text-xs font-bold uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        Desarrollo Web con Astro Framework
      </div>

      <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-tight">
        Sitios Web <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 via-cyan-400 to-indigo-300">Ultrarrápidos</span> para tu Negocio
      </h1>

      <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-2xl">
        En <strong class="text-white font-semibold">Kadmiel</strong> creamos plataformas web de alto rendimiento con Astro JS. Cargas en menos de 1 segundo, 100/100 en Google PageSpeed y el mejor SEO del mercado.
      </p>

      <div id="hero-slider" class="relative bg-slate-900/80 border border-slate-800 rounded-2xl p-6 backdrop-blur-xl shadow-2xl">
        <div class="slide-content transition-all duration-500 min-h-[100px]">
          <div class="slide block" data-index="0">
            <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider">⚡ Velocidad Extrema</span>
            <h3 class="text-xl font-bold text-white mt-1">Carga en menos de 0.8 segundos</h3>
            <p class="text-slate-400 text-sm mt-1">Eliminamos el JavaScript innecesario para entregar páginas instantáneas en móviles y PC.</p>
          </div>
          <div class="slide hidden" data-index="1">
            <span class="text-xs font-bold text-violet-400 uppercase tracking-wider">🎯 SEO Superior</span>
            <h3 class="text-xl font-bold text-white mt-1">Posicionamiento Orgánico Garantizado</h3>
            <p class="text-slate-400 text-sm mt-1">Los algoritmos de Google premian la velocidad perfecta con los primeros lugares en búsquedas.</p>
          </div>
          <div class="slide hidden" data-index="2">
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">🔒 Seguridad Estática</span>
            <h3 class="text-xl font-bold text-white mt-1">Libre de Inyecciones y Hackeos</h3>
            <p class="text-slate-400 text-sm mt-1">Sin bases de datos vulnerables expuestas. Tu sitio estará seguro 24/7 sin mantenimiento complejo.</p>
          </div>
        </div>

        <div class="flex items-center justify-between mt-6 pt-4 border-t border-slate-800">
          <div class="flex gap-2">
            <button id="prev-slide" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button id="next-slide" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
          <div class="flex gap-2" id="slide-dots">
            <span class="dot w-6 h-2 rounded-full bg-cyan-400 transition-all"></span>
            <span class="dot w-2 h-2 rounded-full bg-slate-700 transition-all"></span>
            <span class="dot w-2 h-2 rounded-full bg-slate-700 transition-all"></span>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap gap-4 pt-2">
        <a href="#cotizador" class="px-8 py-4 rounded-xl bg-gradient-to-r from-violet-600 via-indigo-600 to-cyan-500 text-white font-extrabold text-base shadow-xl shadow-violet-600/30 hover:scale-105 transition-all flex items-center gap-2">
          Ver Calculadora de Cotización
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="bg-slate-900/90 border border-violet-500/30 rounded-3xl p-8 backdrop-blur-2xl shadow-2xl relative">
        <div class="absolute -top-4 -right-4 bg-emerald-500 text-slate-950 font-black text-xs px-4 py-1.5 rounded-full shadow-lg">
          Google Verified
        </div>

        <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest text-center mb-6">Puntaje Google PageSpeed Insights</h2>

        <div class="flex justify-center mb-8">
          <div class="relative w-44 h-44 rounded-full border-8 border-emerald-500/20 flex flex-col items-center justify-center bg-emerald-500/5 shadow-inner">
            <span class="text-6xl font-black text-emerald-400">100</span>
            <span class="text-xs font-bold text-emerald-300 tracking-widest uppercase">PERFORMANCE</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 text-center">
          <div class="bg-slate-800/60 p-4 rounded-2xl border border-slate-800">
            <p class="text-xs text-slate-400">FCP (Primer Render)</p>
            <p class="text-xl font-bold text-emerald-400 mt-1">0.3s</p>
          </div>
          <div class="bg-slate-800/60 p-4 rounded-2xl border border-slate-800">
            <p class="text-xs text-slate-400">LCP (Carga Mayor)</p>
            <p class="text-xl font-bold text-emerald-400 mt-1">0.6s</p>
          </div>
          <div class="bg-slate-800/60 p-4 rounded-2xl border border-slate-800">
            <p class="text-xs text-slate-400">TBT (Bloqueo)</p>
            <p class="text-xl font-bold text-emerald-400 mt-1">0ms</p>
          </div>
          <div class="bg-slate-800/60 p-4 rounded-2xl border border-slate-800">
            <p class="text-xs text-slate-400">CLS (Estabilidad)</p>
            <p class="text-xl font-bold text-emerald-400 mt-1">0.00</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.slide');
  const dots = document.querySelectorAll('.dot');
  const totalSlides = slides.length;

  function updateSlide(index) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('hidden');
        slide.classList.add('block');
      } else {
        slide.classList.remove('block');
        slide.classList.add('hidden');
      }
    });

    dots.forEach((dot, i) => {
      if (i === index) {
        dot.className = "dot w-6 h-2 rounded-full bg-cyan-400 transition-all";
      } else {
        dot.className = "dot w-2 h-2 rounded-full bg-slate-700 transition-all";
      }
    });
  }

  document.getElementById('next-slide')?.addEventListener('click', () => {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateSlide(currentSlide);
  });

  document.getElementById('prev-slide')?.addEventListener('click', () => {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    updateSlide(currentSlide);
  });

  setInterval(() => {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateSlide(currentSlide);
  }, 5000);
</script>
