---
import PageSpeedCard from './PageSpeedCard.astro';
---
<section class="relative min-h-screen pt-24 pb-20 flex items-center overflow-hidden bg-[#090d16]">
  
  <!-- Fondo de rejilla (más sutil) -->
  <div class="absolute inset-0 z-0 pointer-events-none opacity-20" 
       style="background-image: linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px); background-size: 50px 50px; mask-image: radial-gradient(ellipse 80% 50% at 50% 0%, #000 70%, transparent 100%);">
  </div>

  <!-- Canvas para la animación de partículas (Red de circuitos) -->
  <canvas id="hero-canvas" class="absolute inset-0 z-0 pointer-events-none w-full h-full"></canvas>

  <!-- Halos de luz -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-violet-600/15 rounded-full blur-[140px] pointer-events-none z-0"></div>
  <div class="absolute top-1/4 right-0 w-[450px] h-[450px] bg-cyan-500/10 rounded-full blur-[130px] pointer-events-none z-0"></div>

  <div class="max-w-7xl mx-auto px-6 w-full grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center relative z-10">
    <!-- Columna izquierda: copy comercial -->
    <div class="lg:col-span-7 space-y-7">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-bold uppercase tracking-widest backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        +40 sitios entregados · 100/100 PageSpeed
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white leading-[1.1] tracking-tight">
        Tu web en
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 via-cyan-400 to-emerald-300"> menos de 1 segundo</span>
        <span class="block mt-1 text-slate-200">o pierdes clientes cada día</span>
      </h1>

      <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-xl">
        En <strong class="text-white">Kadmiel</strong> construimos sitios con <strong class="text-cyan-300">Astro</strong> que cargan al instante, posicionan mejor en Google y convierten más visitas en ventas. Sin plugins lentos. Sin WordPress frágil.
      </p>

      <!-- Beneficios clave en bullets -->
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        <li class="flex items-start gap-2.5 text-slate-200">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold">✓</span>
          <span>Carga &lt; 0.8 s en móvil y PC</span>
        </li>
        <li class="flex items-start gap-2.5 text-slate-200">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold">✓</span>
          <span>Score 95–100 en Google PageSpeed</span>
        </li>
        <li class="flex items-start gap-2.5 text-slate-200">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold">✓</span>
          <span>SEO listo desde el día 1</span>
        </li>
        <li class="flex items-start gap-2.5 text-slate-200">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold">✓</span>
          <span>Entrega en 7–15 días hábiles</span>
        </li>
      </ul>

      <!-- CTAs principales -->
      <div class="flex flex-wrap gap-3 pt-1">
        <a
          href="#cotizador"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-gradient-to-r from-violet-600 via-indigo-600 to-cyan-500 text-white font-extrabold text-base shadow-xl shadow-violet-600/35 hover:scale-[1.03] hover:shadow-cyan-500/30 transition-all"
        >
          Cotizar mi proyecto
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a
          href="#proceso"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border border-slate-700 bg-slate-900/60 backdrop-blur-sm text-slate-200 font-semibold text-base hover:border-cyan-500/50 hover:text-white transition-all"
        >
          Cómo trabajamos
        </a>
      </div>

      <!-- Banner de Oferta Pyme: CON LUZ RECORRIENDO EL BORDE -->
      <a href="#cotizador" class="relative overflow-hidden rounded-2xl p-[2px] mt-8 transition-all hover:scale-[1.02] group z-20 block">
        
        <!-- Efecto de luz giratoria infinita -->
        <div class="absolute inset-[-100%] animate-[spin_4s_linear_infinite] bg-[conic-gradient(from_0deg,transparent_0%,transparent_60%,#8b5cf6_85%,#22d3ee_100%)]"></div>

        <!-- Contenido de la tarjeta (con fondo oscuro para tapar el centro de la luz) -->
        <div class="relative bg-slate-900/95 backdrop-blur-md h-full w-full rounded-[calc(1rem-2px)] p-5 md:p-6 overflow-hidden">
          
          <!-- Etiqueta animada -->
          <div class="absolute top-0 right-0 bg-gradient-to-r from-violet-600 to-indigo-600 text-white text-[11px] font-bold px-4 py-1.5 rounded-bl-xl uppercase tracking-wider shadow-lg animate-pulse z-10">
            Oferta Especial
          </div>
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
            <div class="flex-1 pr-16 sm:pr-0">
              <h3 class="text-white font-extrabold text-xl md:text-2xl leading-tight group-hover:text-violet-300 transition-colors flex items-center gap-2.5">
                <div class="flex items-center justify-center w-8 h-8 rounded-full bg-violet-500/20 text-violet-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                Promoción Pyme Sitio Web
              </h3>
              <p class="text-sm md:text-base text-slate-300 mt-2 ml-10">Incluye dominio y primer mes de servicio.</p>
            </div>
            
            <div class="sm:text-right shrink-0 mt-2 sm:mt-0 bg-slate-950/60 p-3 rounded-xl border border-slate-800/80 shadow-inner">
              <p class="text-2xl md:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-cyan-400">
                $25.000 <span class="text-sm font-medium text-slate-400">/mes</span>
              </p>
              <p class="text-base font-bold text-violet-300 mt-0.5">$45.990 inicial</p>
            </div>
          </div>

        </div>
      </a>

      <!-- Micro-prueba social -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-4 text-xs text-slate-400">
        <span class="flex items-center gap-1.5">
          <span class="text-amber-400">★★★★★</span>
          <span>Clientes pymes y startups</span>
        </span>
        <span class="hidden sm:inline text-slate-600">·</span>
        <span>Sin mensualidades ocultas</span>
        <span class="hidden sm:inline text-slate-600">·</span>
        <span>Soporte post-entrega incluido</span>
      </div>
    </div>

    <!-- Columna derecha: PageSpeed (se mantiene) -->
    <div class="lg:col-span-5 relative z-20">
      <PageSpeedCard score={100} />
      <p class="mt-4 text-center text-xs text-slate-500">
        Ejemplo real de rendimiento que apuntamos en cada proyecto Kadmiel.
      </p>
    </div>
  </div>
</section>

<script>
  // Esperamos a que el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = canvas.width = canvas.offsetWidth;
    let height = canvas.height = canvas.offsetHeight;

    window.addEventListener('resize', () => {
      width = canvas.width = canvas.offsetWidth;
      height = canvas.height = canvas.offsetHeight;
    });

    const particles: { x: number, y: number, vx: number, vy: number, radius: number, color: string }[] = [];
    const particleCount = window.innerWidth < 768 ? 30 : 80; 
    const maxDistance = 150;

    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
        radius: Math.random() * 1.5 + 1,
        color: Math.random() > 0.5 ? 'rgba(34, 211, 238, 0.6)' : 'rgba(139, 92, 246, 0.6)'
      });
    }

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      particles.forEach(p => {
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.fill();
      });

      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const distance = Math.sqrt(dx * dx + dy * dy);

          if (distance < maxDistance) {
            const opacity = 1 - (distance / maxDistance);
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `rgba(139, 92, 246, ${opacity * 0.3})`; 
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(animate);
    }

    animate();
  });
</script>