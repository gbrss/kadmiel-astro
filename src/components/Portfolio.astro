import imgRhino from '../assets/portfolio/rhino-spa.png';
import imgNauticos from '../assets/portfolio/productosnauticos.png';
import imgInnovatar from '../assets/portfolio/innovatar.png';
import imgBrahuier from '../assets/portfolio/brahuertours.png';
import imgPearl from '../assets/portfolio/pearl-iam.png';
import imgMagicprint from '../assets/portfolio/magicprintchile.png';

const projects = [
  {
    id: 1,
    title: 'Minera Milenium',
    category: 'Sitio Corporativo Minería',
    url: 'https://mineramilenium.cl',
    score: 99,
    description: 'Sitio corporativo para el sector minero: presencia digital sólida, SEO y contacto directo.',
    image: imgMineramilenium,
    tags: ['Corporativo', 'SEO', 'Astro'],
  },
  {
    id: 2,
    title: 'Rhino SpA',
    category: 'Tienda Web / Catálogo',
    url: 'https://rhino-spa.cl',
    score: 100,
    description: 'Sitio corporativo para el sector minero: presencia digital sólida, SEO y contacto directo.',
    image: imgRhino,
    tags: ['Servicios', 'SEO', 'Astro'],
  },
  {
    id: 3,
    title: 'Productos Náuticos',
    category: 'Tienda Web / Catálogo',
    url: 'https://productosnauticos.cl',
    score: 100,
    description: 'Catálogo online de productos náuticos con navegación rápida y foco en conversión.',
    image: imgNauticos,
    tags: ['Catálogo', 'WebPay', 'Astro'],
  },
  {
    id: 4,
    title: 'Innovatar',
    category: 'Landing + Agente Bot IA',
    url: 'https://innovatar.cl',
    score: 97,
    description: 'Landing de automatización de negocios en Chile con agente bot IA integrado.',
    image: imgInnovatar,
    tags: ['Landing', 'Bot IA', 'Astro'],
  },
  {
    id: 5,
    title: 'Brahuier Tours',
    category: 'Landing Page / Turismo',
    url: 'https://brahuertours.cl',
    score: 98,
    description: 'Turismo y transporte: landing de alta conversión con Webpay y Core Web Vitals altos.',
    image: imgBrahuier,
    tags: ['Turismo', 'Webpay', 'Landing'],
  },
  {
    id: 6,
    title: 'Pearl I Am',
    category: 'Sitio Corporativo Holding',
    url: 'https://pearl-iam.cl',
    score: 99,
    description: 'Sitio multi-sección para holding: liderazgo, sostenibilidad y carga sub-segundo.',
    image: imgPearl,
    tags: ['Corporativo', 'SEO', 'Astro'],
  },
  {
    id: 7,
    title: 'MagicPrintChile',
    category: 'Sitio Landing Catálogo',
    url: 'https://magicprintchile.cl',
    score: 99,
    description: 'Sitio multi-sección para holding: liderazgo, sostenibilidad y carga sub-segundo.',
    image: imgMagicprint,
    tags: ['Catálogo', 'SEO', 'Astro'],
