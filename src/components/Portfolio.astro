    category: 'Landing Page / Turismo',
    url: 'https://brahuertours.cl',
    score: 98,
    description: 'Turismo y transporte: landing de alta conversión con Webpay y Core Web Vitals altos.',
    image: '/portafolio/brahuertours.png',
    tags: ['Turismo', 'Webpay', 'Landing'],
  },
  {
    id: 5,
