---

<section id="portafolio" class="py-24 bg-slate-950 border-t border-slate-800/80 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div class="max-w-2xl">
        <h2 class="text-xs font-bold text-cyan-400 tracking-widest uppercase mb-3">Portafolio</h2>
        <p class="text-3xl md:text-4xl font-extrabold text-white leading-tight">
          Sitios reales. Resultados medibles.
        </p>
        <p class="mt-3 text-slate-400 text-base">
          Cada proyecto se entrega con foco en velocidad, SEO y conversión. Desliza para ver ejemplos del estilo de trabajo Kadmiel.
        </p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button type="button" id="pf-prev" aria-label="Proyecto anterior"
          class="w-11 h-11 rounded-xl border border-slate-700 bg-slate-900 text-slate-300 hover:border-cyan-500/50 hover:text-white transition-colors flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button type="button" id="pf-next" aria-label="Proyecto siguiente"
          class="w-11 h-11 rounded-xl border border-slate-700 bg-slate-900 text-slate-300 hover:border-cyan-500/50 hover:text-white transition-colors flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <div class="relative">
      <div id="pf-track" class="flex gap-5 overflow-x-auto snap-x snap-mandatory pb-4 -mx-2 px-2 scrollbar-hide cursor-grab active:cursor-grabbing select-none"
        style="scrollbar-width: none; -ms-overflow-style: none;">
        {projects.map((p) => (
          <article class="pf-card snap-start shrink-0 w-[min(100%,320px)] sm:w-[340px] rounded-2xl border border-slate-800 bg-slate-900/70 overflow-hidden group hover:border-cyan-500/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-cyan-500/15" data-project={p.id}>
            <div class="relative aspect-[16/10] overflow-hidden bg-slate-950">
              <img src={p.image} alt={`Captura de ${p.title}`}
                class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                loading="lazy" width="800" height="500" />
              <div class="absolute top-3 right-3 z-10 flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-950/90 border border-emerald-500/40 shadow-lg backdrop-blur-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-[11px] font-bold text-emerald-300 tabular-nums">{p.score}/100</span>
              </div>
            </div>
            <div class="p-5">
              <div class="flex flex-wrap gap-1.5 mb-3">
                {p.tags.map((t) => (
                  <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-md bg-slate-800 text-slate-400 border border-slate-700/80">{t}</span>
                ))}
              </div>
              <h3 class="text-base font-bold text-white group-hover:text-cyan-300 transition-colors">{p.title}</h3>
              <p class="text-[11px] text-slate-500 font-mono mt-0.5 truncate">{p.url.replace(/^https?:\/\//, '')}</p>
              <p class="mt-1.5 text-sm text-slate-400 leading-relaxed line-clamp-2">{p.description}</p>
              <a href={p.url} target="_blank" rel="noopener noreferrer"
                class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors">
                Ver sitio
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="flex justify-center gap-2 mt-6" id="pf-dots" role="tablist" aria-label="Proyectos">
      {projects.map((_, i) => (
        <button type="button" class="pf-dot h-2 rounded-full transition-all duration-300 bg-slate-700 w-2" data-index={i} aria-label={`Ir al proyecto ${i + 1}`} />
      ))}
    </div>
    <p class="mt-8 text-center text-xs text-slate-500">
      ¿Quieres ver tu marca aquí?{' '}
      <a href="#cotizador" class="text-cyan-400 hover:text-cyan-300 font-semibold">Cotiza tu proyecto</a>
      {' '}o escríbenos por WhatsApp.
    </p>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }

  .pf-card {
    animation: pfIn 0.5s ease-out both;
  }
  .pf-card:nth-child(1) { animation-delay: 0.05s; }
  .pf-card:nth-child(2) { animation-delay: 0.1s; }
  .pf-card:nth-child(3) { animation-delay: 0.15s; }
  .pf-card:nth-child(4) { animation-delay: 0.2s; }
  .pf-card:nth-child(5) { animation-delay: 0.25s; }

  @keyframes pfIn {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  #pf-track {
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-card { animation: none; }
  }
</style>

<script>
  const track = document.getElementById('pf-track') as HTMLElement | null;
  const prevBtn = document.getElementById('pf-prev');
  const nextBtn = document.getElementById('pf-next');
  const dots = document.querySelectorAll('.pf-dot');

  if (track) {
    const el = track;
    const cards = el.querySelectorAll('.pf-card');
    const gap = 20;

    function cardWidth(): number {
      const first = cards[0] as HTMLElement | undefined;
      return first ? first.offsetWidth + gap : 340;
    }
    function currentIndex(): number {
      return Math.round(el.scrollLeft / cardWidth());
    }
    function updateDots() {
      const idx = currentIndex();
      dots.forEach((d, i) => {
        d.className = i === idx
          ? 'pf-dot h-2 rounded-full transition-all duration-300 bg-cyan-400 w-6'
          : 'pf-dot h-2 rounded-full transition-all duration-300 bg-slate-700 w-2';
      });
    }
    function scrollToIndex(i: number) {
      const clamped = Math.max(0, Math.min(cards.length - 1, i));
      el.scrollTo({ left: clamped * cardWidth(), behavior: 'smooth' });
    }

    // --- Drag (mouse + touch) sin bloquear links ---
    let isDown = false;
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    let pointerId: number | null = null;
    let userPaused = false;

    el.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      const target = e.target as HTMLElement | null;
      // No iniciar drag sobre links o botones
      if (target?.closest('a, button')) return;
      isDown = true;
      dragging = false;
      startX = e.clientX;
      startScroll = el.scrollLeft;
      pointerId = e.pointerId;
      userPaused = true;
    });

    el.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isDown) return;
      const dx = e.clientX - startX;
      if (!dragging && Math.abs(dx) > 6) {
        dragging = true;
        if (pointerId !== null) {
          try { el.setPointerCapture(pointerId); } catch {}
        }
        el.classList.add('cursor-grabbing');
        el.classList.remove('cursor-grab');
      }
      if (!dragging) return;
      el.scrollLeft = startScroll - dx;
      e.preventDefault();
    });

    function endDrag(e: PointerEvent) {
      if (!isDown) return;
      const wasDragging = dragging;
      isDown = false;
      dragging = false;
      el.classList.remove('cursor-grabbing');
      el.classList.add('cursor-grab');
      if (pointerId !== null) {
        try { el.releasePointerCapture(pointerId); } catch {}
        pointerId = null;
      }
      if (wasDragging) {
        scrollToIndex(currentIndex());
      }
      setTimeout(() => { userPaused = false; }, 8000);
    }

    el.addEventListener('pointerup', endDrag);
    el.addEventListener('pointercancel', endDrag);

    // Solo cancelar click si hubo arrastre real
    el.addEventListener('click', (e) => {
      if (dragging) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);

    prevBtn?.addEventListener('click', () => { userPaused = true; scrollToIndex(currentIndex() - 1); setTimeout(() => { userPaused = false; }, 8000); });
    nextBtn?.addEventListener('click', () => { userPaused = true; scrollToIndex(currentIndex() + 1); setTimeout(() => { userPaused = false; }, 8000); });
    dots.forEach((d) => d.addEventListener('click', () => {
      userPaused = true;
      scrollToIndex(parseInt(d.getAttribute('data-index') || '0', 10));
      setTimeout(() => { userPaused = false; }, 8000);
    }));

    el.addEventListener('scroll', () => requestAnimationFrame(updateDots), { passive: true });

    let autoTimer: ReturnType<typeof setInterval> | null = null;
    function startAuto() {
      if (autoTimer) clearInterval(autoTimer);
      autoTimer = setInterval(() => {
        if (userPaused || isDown) return;
        const next = currentIndex() + 1;
        scrollToIndex(next >= cards.length ? 0 : next);
      }, 5000);
    }
    updateDots();
    startAuto();
  }
</script>