    url: 'https://productosnauticos.cl',
    score: 100,
    description: 'Catálogo online de productos náuticos con navegación rápida y foco en conversión.',
    image: '/portafolio/productosnauticos.png',
    tags: ['Catálogo', 'WebPay', 'Astro'],
  },
  {
    id: 3,
    title: 'Innovatar',
    category: 'Landing + Agente Bot IA',
    url: 'https://innovatar.cl',
    score: 97,
    description: 'Landing de automatización de negocios en Chile con agente bot IA integrado.',
    image: '/portafolio/innovatar.png',
    tags: ['Landing', 'Bot IA', 'Astro'],
