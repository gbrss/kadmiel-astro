    score: 100,
    description: 'Sitio corporativo para el sector minero: presencia digital sólida, SEO y contacto directo.',
    image: '/portafolio/rhino-spa.png',
    tags: ['Servicios', 'SEO', 'Astro'],
  },
  {
    id: 3,
    title: 'Productos Náuticos',
