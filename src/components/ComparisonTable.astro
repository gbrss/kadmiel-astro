---
---
<section id="comparativa" class="py-24 bg-slate-950 border-t border-slate-800/80">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-bold text-violet-400 tracking-widest uppercase mb-3">Comparativa de Rendimiento</h2>
      <p class="text-3xl md:text-4xl font-extrabold text-white">WordPress Tradicional vs Kadmiel (Astro JS)</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[600px]">
        <thead>
          <tr class="border-b border-slate-800">
            <th class="py-4 px-6 text-slate-400 font-semibold text-sm">Métrica / Característica</th>
            <th class="py-4 px-6 text-rose-400 font-bold text-base">WordPress Tradicional</th>
            <th class="py-4 px-6 text-cyan-400 font-bold text-base">Kadmiel + Astro JS</th>
            <th class="py-4 px-6 text-emerald-400 font-bold text-base">Mejora</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 text-sm">
          <tr>
            <td class="py-5 px-6 font-semibold text-white">Tiempo de Carga Promedio</td>
            <td class="py-5 px-6 text-slate-400">3.5 - 5.0 segundos</td>
            <td class="py-5 px-6 text-cyan-300 font-bold">0.5 - 0.8 segundos</td>
            <td class="py-5 px-6 text-emerald-400 font-bold">+85% más rápido</td>
          </tr>
          <tr>
            <td class="py-5 px-6 font-semibold text-white">Score Core Web Vitals</td>
            <td class="py-5 px-6 text-slate-400">50 - 75 / 100</td>
            <td class="py-5 px-6 text-cyan-300 font-bold">95 - 100 / 100</td>
            <td class="py-5 px-6 text-emerald-400 font-bold">Máxima Calificación</td>
          </tr>
          <tr>
            <td class="py-5 px-6 font-semibold text-white">Peso de la Página</td>
            <td class="py-5 px-6 text-slate-400">2.5MB - 5.0MB</td>
            <td class="py-5 px-6 text-cyan-300 font-bold">150KB - 400KB</td>
            <td class="py-5 px-6 text-emerald-400 font-bold">90% más liviano</td>
          </tr>
          <tr>
            <td class="py-5 px-6 font-semibold text-white">Seguridad frente a Hackeos</td>
            <td class="py-5 px-6 text-slate-400">Vulnerable (Plugins, SQL)</td>
            <td class="py-5 px-6 text-cyan-300 font-bold">Inviolable (Estático)</td>
            <td class="py-5 px-6 text-emerald-400 font-bold">Sin Base de Datos Expuesta</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
