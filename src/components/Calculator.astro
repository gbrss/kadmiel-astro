---
---
<section id="cotizador" class="py-24 bg-[#090d16] border-t border-slate-800/80">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-bold text-cyan-400 tracking-widest uppercase mb-3">Calculadora Transparente</h2>
      <p class="text-3xl md:text-5xl font-extrabold text-white">Estima el Valor de tu Proyecto Web</p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 md:p-12 shadow-2xl">
      <div class="space-y-8">
        <div>
          <label class="block text-slate-300 text-sm font-bold mb-3">1. Tipo de Proyecto Web:</label>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <button class="type-btn active border-2 border-violet-500 bg-violet-500/10 p-4 rounded-xl text-left" data-price="250000" data-type="Landing Page">
              <span class="block text-white font-bold text-base">Landing Page</span>
              <span class="block text-xs text-slate-400 mt-1">Ideal para campañas de conversión de 1 sola página.</span>
            </button>
            <button class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left" data-price="450000" data-type="Sitio Pyme / Corporativo">
              <span class="block text-white font-bold text-base">Sitio Corporativo</span>
              <span class="block text-xs text-slate-400 mt-1">Hasta 5 secciones completas con formulario SEO.</span>
            </button>
            <button class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left" data-price="750000" data-type="E-Commerce Catálogo">
              <span class="block text-white font-bold text-base">Catálogo / Tienda</span>
              <span class="block text-xs text-slate-400 mt-1">Integración de productos y WhatsApp/Pasarela.</span>
            </button>
          </div>
        </div>

        <div>
          <label class="block text-slate-300 text-sm font-bold mb-3">2. Módulos Adicionales:</label>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <label class="flex items-center gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer">
              <input type="checkbox" class="mod-check accent-violet-500 w-5 h-5" value="60000" />
              <span class="text-sm text-slate-200">Chatbot de WhatsApp o IA (+ $60.000)</span>
            </label>
            <label class="flex items-center gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer">
              <input type="checkbox" class="mod-check accent-violet-500 w-5 h-5" value="80000" />
              <span class="text-sm text-slate-200">Optimización Google Business (+ $80.000)</span>
            </label>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-slate-950 border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Inversión Estimada (CLP)</span>
            <div id="total-price" class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-cyan-400">$250.000 CLP</div>
          </div>
          <button id="send-quote" class="w-full md:w-auto px-8 py-4 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black text-base shadow-lg shadow-cyan-500/20 transition-all">
            Solicitar esta Cotización
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let basePrice = 250000;
  
  const typeBtns = document.querySelectorAll('.type-btn');
  const modChecks = document.querySelectorAll('.mod-check');
  const totalPriceEl = document.getElementById('total-price');

  function calculateTotal() {
    let modsTotal = 0;
    modChecks.forEach(chk => {
      if ((chk as HTMLInputElement).checked) {
        modsTotal += parseInt((chk as HTMLInputElement).value);
      }
    });
    const total = basePrice + modsTotal;
    if (totalPriceEl) {
      totalPriceEl.textContent = `$${total.toLocaleString('es-CL')} CLP`;
    }
  }

  typeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      typeBtns.forEach(b => {
        b.classList.remove('border-violet-500', 'bg-violet-500/10');
        b.classList.add('border-slate-800');
      });
      btn.classList.remove('border-slate-800');
      btn.classList.add('border-violet-500', 'bg-violet-500/10');
      basePrice = parseInt(btn.getAttribute('data-price') || '250000');
      calculateTotal();
    });
  });

  modChecks.forEach(chk => {
    chk.addEventListener('change', calculateTotal);
  });

  document.getElementById('send-quote')?.addEventListener('click', () => {
    alert(`¡Gracias por cotizar con Kadmiel! Nos pondremos en contacto para tu proyecto.`);
  });
</script>
