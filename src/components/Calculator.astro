---
---
<section id="cotizador" class="py-24 bg-[#090d16] border-t border-slate-800/80">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-bold text-cyan-400 tracking-widest uppercase mb-3">Calculadora Transparente</h2>
      <p class="text-3xl md:text-5xl font-extrabold text-white">Estima el Valor de tu Proyecto Web</p>
      <p class="mt-3 text-slate-400 text-sm md:text-base">Selecciona el tipo de sitio y módulos. Al finalizar te enviamos el detalle por WhatsApp.</p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 md:p-12 shadow-2xl">
      <div class="space-y-8">
        <!-- Tipo de proyecto -->
        <div>
          <label class="block text-slate-300 text-sm font-bold mb-3">1. Tipo de Proyecto Web:</label>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4" role="group" aria-label="Tipo de proyecto">
            <button
              type="button"
              class="type-btn active border-2 border-violet-500 bg-violet-500/10 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400"
              data-price="150000"
              data-type="Landing Page"
              aria-pressed="true"
            >
              <span class="block text-white font-bold text-base">Landing Page</span>
              <span class="block text-xs text-slate-400 mt-1">Ideal para campañas de conversión de 1 sola página.</span>
              <span class="block text-violet-300 text-sm font-semibold mt-2">$150.000</span>
            </button>
            <button
              type="button"
              class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400"
              data-price="250000"
              data-type="Sitio Corporativo"
              aria-pressed="false"
            >
              <span class="block text-white font-bold text-base">Sitio Corporativo</span>
              <span class="block text-xs text-slate-400 mt-1">Hasta 5 secciones completas con formulario SEO.</span>
              <span class="block text-slate-400 text-sm font-semibold mt-2">$250.000</span>
            </button>
            <button
              type="button"
              class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400"
              data-price="350000"
              data-type="Catálogo / Tienda"
              aria-pressed="false"
            >
              <span class="block text-white font-bold text-base">Catálogo / Tienda</span>
              <span class="block text-xs text-slate-400 mt-1">Integración de productos y WhatsApp/Pasarela.</span>
              <span class="block text-slate-400 text-sm font-semibold mt-2">$350.000</span>
            </button>
            <button
              type="button"
              class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400"
              data-price="99000"
              data-type="Redes Sociales"
              aria-pressed="false"
            >
              <span class="block text-white font-bold text-base">Redes Sociales</span>
              <span class="block text-xs text-slate-400 mt-1">Gestión profesional de Redes Sociales</span>
              <span class="block text-slate-400 text-sm font-semibold mt-2">$99.000</span>
            </button>
          </div>
        </br>
        <!-- Módulos adicionales -->
        <div>
          <label class="block text-slate-300 text-sm font-bold mb-3">2. Módulos Adicionales:</label>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <label class="mod-label flex items-start gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors has-[:checked]:border-violet-500 has-[:checked]:bg-violet-500/10">
              <input
                type="checkbox"
                class="mod-check accent-violet-500 w-5 h-5 mt-0.5 shrink-0"
                value="60000"
                data-name="Chatbot de WhatsApp o IA"
              />
              <span class="text-sm text-slate-200">
                <span class="font-medium text-white">Chatbot de WhatsApp o IA</span>
                <span class="block text-slate-400 text-xs mt-0.5">Respuestas automáticas y captura de leads</span>
                <span class="block text-violet-300 text-sm font-semibold mt-1">+ $60.000</span>
              </span>
            </label>
            <label class="mod-label flex items-start gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors has-[:checked]:border-violet-500 has-[:checked]:bg-violet-500/10">
              <input
                type="checkbox"
                class="mod-check accent-violet-500 w-5 h-5 mt-0.5 shrink-0"
                value="80000"
                data-name="Optimización Google Business"
              />
              <span class="text-sm text-slate-200">
                <span class="font-medium text-white">Optimización Google Business</span>
                <span class="block text-slate-400 text-xs mt-0.5">Perfil, reseñas y visibilidad local</span>
                <span class="block text-violet-300 text-sm font-semibold mt-1">+ $80.000</span>
              </span>
            </label>
          </div>
        </div>

        <!-- Resumen + CTA -->
        <div class="p-6 rounded-2xl bg-slate-950 border border-slate-800">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex-1 min-w-0">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Inversión Estimada (CLP)</span>
              <div id="total-price" class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-cyan-400 mt-1">
                $150.000 CLP
              </div>
              <p id="quote-summary" class="mt-2 text-sm text-slate-400 leading-relaxed">
                Landing Page
              </p>
            </div>
            <button
              type="button"
              id="send-quote"
              class="w-full md:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-[#25d366] hover:bg-[#20bd5a] text-white font-black text-base shadow-lg shadow-green-500/25 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-green-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
            >
              <svg class="w-5 h-5" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
                <path d="M16.001 2.002c-7.713 0-13.975 6.262-13.975 13.975 0 2.465.643 4.868 1.865 6.99L2 30l7.2-1.886a13.92 13.92 0 006.801 1.735h.006c7.713 0 13.975-6.262 13.975-13.975S23.714 2.002 16.001 2.002zm0 25.54a11.54 11.54 0 01-5.88-1.605l-.421-.25-4.42 1.158 1.18-4.31-.274-.442a11.55 11.55 0 01-1.777-6.116c0-6.38 5.193-11.573 11.574-11.573 6.38 0 11.573 5.193 11.573 11.573 0 6.381-5.193 11.565-11.555 11.565zm6.352-8.666c-.348-.174-2.06-1.016-2.38-1.132-.32-.116-.553-.174-.786.174-.233.348-.902 1.132-1.105 1.365-.203.233-.406.262-.754.087-.348-.174-1.47-.542-2.8-1.727-1.035-.923-1.734-2.062-1.937-2.41-.203-.348-.022-.536.152-.71.156-.155.348-.406.522-.61.174-.203.233-.348.348-.58.116-.233.058-.436-.029-.61-.087-.174-.786-1.894-1.077-2.595-.283-.68-.57-.588-.786-.6-.203-.01-.436-.012-.669-.012s-.61.087-.93.436c-.32.348-1.22 1.192-1.22 2.906s1.25 3.37 1.423 3.603c.174.233 2.46 3.757 5.96 5.267 2.21.953 3.077.87 3.64.813.552-.058 2.06-.842 2.35-1.655.29-.813.29-1.51.203-1.655-.087-.145-.32-.233-.669-.406z"/>
              </svg>
              Solicitar por WhatsApp
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const PHONE = '56945422388'; // sin + ni espacios (formato wa.me)

  let basePrice = 150000;
  let selectedType = 'Landing Page';

  const typeBtns = document.querySelectorAll('.type-btn');
  const modChecks = document.querySelectorAll('.mod-check');
  const totalPriceEl = document.getElementById('total-price');
  const quoteSummaryEl = document.getElementById('quote-summary');
  const sendQuoteBtn = document.getElementById('send-quote');

  function formatCLP(n: number): string {
    return `$${n.toLocaleString('es-CL')} CLP`;
  }

  function getSelectedModules(): { name: string; price: number }[] {
    const mods: { name: string; price: number }[] = [];
    modChecks.forEach((chk) => {
      const input = chk as HTMLInputElement;
      if (input.checked) {
        mods.push({
          name: input.getAttribute('data-name') || 'Módulo',
          price: parseInt(input.value, 10) || 0,
        });
      }
    });
    return mods;
  }

  function calculateTotal(): number {
    const mods = getSelectedModules();
    const modsTotal = mods.reduce((sum, m) => sum + m.price, 0);
    return basePrice + modsTotal;
  }

  function updateUI() {
    const total = calculateTotal();
    const mods = getSelectedModules();

    if (totalPriceEl) {
      totalPriceEl.textContent = formatCLP(total);
    }

    if (quoteSummaryEl) {
      if (mods.length === 0) {
        quoteSummaryEl.textContent = selectedType;
      } else {
        const modsText = mods.map((m) => m.name).join(' · ');
        quoteSummaryEl.textContent = `${selectedType} + ${modsText}`;
      }
    }
  }

  function buildWhatsAppMessage(): string {
    const mods = getSelectedModules();
    const total = calculateTotal();

    let lines = [
      'Hola! Quiero solicitar una cotización con Kadmiel:',
      '',
      `• Proyecto: ${selectedType} (${formatCLP(basePrice)})`,
    ];

    if (mods.length > 0) {
      lines.push('• Módulos adicionales:');
      mods.forEach((m) => {
        lines.push(`  – ${m.name}: ${formatCLP(m.price)}`);
      });
    } else {
      lines.push('• Sin módulos adicionales');
    }

    lines.push('', `*Total estimado: ${formatCLP(total)}*`, '', '¿Podemos conversar sobre este proyecto?');

    return lines.join('\n');
  }

  function openWhatsApp() {
    const message = encodeURIComponent(buildWhatsAppMessage());
    const url = `https://wa.me/${PHONE}?text=${message}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  }

  // Tipo de proyecto
  typeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      typeBtns.forEach((b) => {
        b.classList.remove('border-violet-500', 'bg-violet-500/10', 'active');
        b.classList.add('border-slate-800');
        b.setAttribute('aria-pressed', 'false');
        const priceSpan = b.querySelector('span:last-child');
        if (priceSpan) {
          priceSpan.classList.remove('text-violet-300');
          priceSpan.classList.add('text-slate-400');
        }
      });

      btn.classList.remove('border-slate-800');
      btn.classList.add('border-violet-500', 'bg-violet-500/10', 'active');
      btn.setAttribute('aria-pressed', 'true');

      const activePriceSpan = btn.querySelector('span:last-child');
      if (activePriceSpan) {
        activePriceSpan.classList.remove('text-slate-400');
        activePriceSpan.classList.add('text-violet-300');
      }

      basePrice = parseInt(btn.getAttribute('data-price') || '150000', 10);
      selectedType = btn.getAttribute('data-type') || 'Landing Page';
      updateUI();
    });
  });

  // Módulos
  modChecks.forEach((chk) => {
    chk.addEventListener('change', updateUI);
  });

  // CTA → WhatsApp con detalle
  sendQuoteBtn?.addEventListener('click', openWhatsApp);

  // Estado inicial coherente
  updateUI();
</script>
