---
---
<section id="cotizador" class="py-24 bg-kadmiel-bg border-t border-slate-800/80">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-bold text-cyan-400 tracking-widest uppercase mb-3">Calculadora Transparente</h2>
      <p class="text-3xl md:text-5xl font-extrabold text-white">Estima el Valor de tu Proyecto Web</p>
      <p class="mt-3 text-slate-400 text-sm md:text-base">Selecciona el tipo de sitio y módulos. Al finalizar puedes enviarnos el detalle por WhatsApp o por correo.</p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 md:p-12 shadow-2xl">
      <div class="space-y-8">
        <!-- Tipo de proyecto -->
        <div>
          <label class="block text-slate-300 text-sm font-bold mb-3">1. Tipo de Proyecto Web:</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" role="group" aria-label="Tipo de proyecto">
            
            <!-- TARJETA PROMO ACTIVA POR DEFECTO -->
            <button type="button" class="type-btn active lg:col-span-3 border-2 border-violet-500 bg-violet-500/10 p-5 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400 relative overflow-hidden flex flex-col md:flex-row md:items-center justify-between gap-4" data-price="45990" data-type="Promoción Pyme Sitio Web (Inicial $45.990 + $25.000/mes)" aria-pressed="true">
              
              <div class="absolute top-0 right-0 bg-violet-600 text-white text-[10px] font-bold px-3 py-1 rounded-bl-lg uppercase tracking-wider z-10">
                Oferta Especial
              </div>

              <div class="flex-1 pr-16 md:pr-0">
                <span class="block text-white font-bold text-lg">Promoción Pyme Sitio Web</span>
                <span class="block text-xs text-slate-400 mt-1">Incluye dominio y primer mes de servicio.</span>
              </div>
              
              <span class="block text-violet-300 text-sm font-semibold md:text-right w-full md:w-auto mt-2 md:mt-0">
                $25.000 mensuales / $45.990 inicial
              </span>
            </button>

            <!-- Las 9 tarjetas originales -->
            <button type="button" class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400" data-price="150000" data-type="Landing Page" aria-pressed="false">
              <span class="block text-white font-bold text-base">Landing Page</span>
              <span class="block text-xs text-slate-400 mt-1">Una página enfocada en conversión y campañas.</span>
              <span class="block text-slate-400 text-sm font-semibold mt-2">$150.000</span>
            </button>
            <button type="button" class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400" data-price="250000" data-type="Sitio Corporativo" aria-pressed="false">
              <span class="block text-white font-bold text-base">Sitio Corporativo</span>
              <span class="block text-xs text-slate-400 mt-1">Hasta 5 secciones con formulario y SEO base.</span>
              <span class="block text-slate-400 text-sm font-semibold mt-2">$250.000</span>
            </button>
            <button type="button" class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400" data-price="320000" data-type="Corporativo + Blog" aria-pressed="false">
              <span class="block text-white font-bold text-base">Corporativo + Blog</span>
              <span class="block text-xs text-slate-400 mt-1">Sitio de empresa con blog para contenido y SEO.</span>
              <span class="block text-slate-400 text-sm font-semibold mt-2">$320.000</span>
            </button>
            <button type="button" class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400" data-price="280000" data-type="Migración desde WordPress" aria-pressed="false">
              <span class="block text-white font-bold text-base">Migración WordPress</span>
              <span class="block text-xs text-slate-400 mt-1">Pasamos tu sitio actual a Astro, más rápido y seguro.</span>
              <span class="block text-slate-400 text-sm font-semibold mt-2">$280.000</span>
            </button>
            <button type="button" class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400" data-price="340000" data-type="Sistema de Reservas" aria-pressed="false">
              <span class="block text-white font-bold text-base">Sistema de Reservas</span>
              <span class="block text-xs text-slate-400 mt-1">Reservas online para productos o servicios.</span>
              <span class="block text-slate-400 text-sm font-semibold mt-2">$340.000</span>
            </button>
            <button type="button" class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400" data-price="360000" data-type="Catálogo / Tienda" aria-pressed="false">
              <span class="block text-white font-bold text-base">Catálogo / Tienda</span>
              <span class="block text-xs text-slate-400 mt-1">Productos, filtros y contacto o pasarela de pago.</span>
              <span class="block text-slate-400 text-sm font-semibold mt-2">$360.000</span>
            </button>
            <button type="button" class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400" data-price="450000" data-type="Portal / Área clientes" aria-pressed="false">
              <span class="block text-white font-bold text-base">Portal / Área clientes</span>
              <span class="block text-xs text-slate-400 mt-1">Zona privada simple para clientes o socios.</span>
              <span class="block text-slate-400 text-sm font-semibold mt-2">$450.000</span>
            </button>
            <button type="button" class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400" data-price="180000" data-type="One-Page + SEO local" aria-pressed="false">
              <span class="block text-white font-bold text-base">One-Page + SEO local</span>
              <span class="block text-xs text-slate-400 mt-1">Landing optimizada para negocio de barrio o ciudad.</span>
              <span class="block text-slate-400 text-sm font-semibold mt-2">$180.000</span>
            </button>
            <button type="button" class="type-btn border-2 border-slate-800 hover:border-slate-700 p-4 rounded-xl text-left transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400" data-price="420000" data-type="E-commerce completo" aria-pressed="false">
              <span class="block text-white font-bold text-base">E-commerce completo</span>
              <span class="block text-xs text-slate-400 mt-1">Tienda con carrito, pagos y gestión de pedidos.</span>
              <span class="block text-slate-400 text-sm font-semibold mt-2">$420.000</span>
            </button>
          </div>
        </div>

        <!-- Módulos adicionales -->
        <div>
          <label class="block text-slate-300 text-sm font-bold mb-3">2. Módulos Adicionales:</label>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- AGREGADO: id="mod-chatbot" y for="mod-chatbot" -->
            <label for="mod-chatbot" class="mod-label flex items-start gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors has-checked:border-violet-500 has-checked:bg-violet-500/10">
              <input id="mod-chatbot" type="checkbox" class="mod-check accent-violet-500 w-5 h-5 mt-0.5 shrink-0" value="63000" data-name="Chatbot de WhatsApp o IA" />
              <span class="text-sm text-slate-200">
                <span class="font-medium text-white">Chatbot de WhatsApp o IA</span>
                <span class="block text-slate-400 text-xs mt-0.5">Respuestas automáticas y captura de leads</span>
                <span class="block text-violet-300 text-sm font-semibold mt-1">+ $63.000</span>
              </span>
            </label>
            
            <label for="mod-google" class="mod-label flex items-start gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors has-checked:border-violet-500 has-checked:bg-violet-500/10">
              <input id="mod-google" type="checkbox" class="mod-check accent-violet-500 w-5 h-5 mt-0.5 shrink-0" value="79000" data-name="Optimización Google Business" />
              <span class="text-sm text-slate-200">
                <span class="font-medium text-white">Optimización Google Business</span>
                <span class="block text-slate-400 text-xs mt-0.5">Perfil, reseñas y visibilidad local</span>
                <span class="block text-violet-300 text-sm font-semibold mt-1">+ $79.000</span>
              </span>
            </label>
            
            <label for="mod-redes" class="mod-label flex items-start gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors has-checked:border-violet-500 has-checked:bg-violet-500/10">
              <input id="mod-redes" type="checkbox" class="mod-check accent-violet-500 w-5 h-5 mt-0.5 shrink-0" value="99000" data-name="Gestión de Redes Sociales" />
              <span class="text-sm text-slate-200">
                <span class="font-medium text-white">Gestión de Redes Sociales</span>
                <span class="block text-slate-400 text-xs mt-0.5">Gestión profesional de redes (pack inicial)</span>
                <span class="block text-violet-300 text-sm font-semibold mt-1">+ $99.000</span>
              </span>
            </label>
            
            <label for="mod-agente" class="mod-label flex items-start gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors has-checked:border-violet-500 has-checked:bg-violet-500/10">
              <input id="mod-agente" type="checkbox" class="mod-check accent-violet-500 w-5 h-5 mt-0.5 shrink-0" value="99000" data-name="Agente de Ventas Automatizado" />
              <span class="text-sm text-slate-200">
                <span class="font-medium text-white">Agente de Ventas Automatizado</span>
                <span class="block text-slate-400 text-xs mt-0.5">Asistente para calificar y atender consultas</span>
                <span class="block text-violet-300 text-sm font-semibold mt-1">+ $99.000</span>
              </span>
            </label>
            
            <label for="mod-seo" class="mod-label flex items-start gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors has-checked:border-violet-500 has-checked:bg-violet-500/10">
              <input id="mod-seo" type="checkbox" class="mod-check accent-violet-500 w-5 h-5 mt-0.5 shrink-0" value="89000" data-name="SEO técnico + on-page inicial" />
              <span class="text-sm text-slate-200">
                <span class="font-medium text-white">SEO técnico + on-page inicial</span>
                <span class="block text-slate-400 text-xs mt-0.5">Estructura, metas y base para posicionar</span>
                <span class="block text-violet-300 text-sm font-semibold mt-1">+ $89.000</span>
              </span>
            </label>
            
            <label for="mod-webpay" class="mod-label flex items-start gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors has-checked:border-violet-500 has-checked:bg-violet-500/10">
              <input id="mod-webpay" type="checkbox" class="mod-check accent-violet-500 w-5 h-5 mt-0.5 shrink-0" value="120000" data-name="Integración Webpay / pagos" />
              <span class="text-sm text-slate-200">
                <span class="font-medium text-white">Integración Webpay / pagos</span>
                <span class="block text-slate-400 text-xs mt-0.5">Cobros online para catálogo o reservas</span>
                <span class="block text-violet-300 text-sm font-semibold mt-1">+ $120.000</span>
              </span>
            </label>
            
            <label for="mod-analytics" class="mod-label flex items-start gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors has-checked:border-violet-500 has-checked:bg-violet-500/10">
              <input id="mod-analytics" type="checkbox" class="mod-check accent-violet-500 w-5 h-5 mt-0.5 shrink-0" value="45000" data-name="Analytics + Search Console" />
              <span class="text-sm text-slate-200">
                <span class="font-medium text-white">Analytics + Search Console</span>
                <span class="block text-slate-400 text-xs mt-0.5">Medición de visitas y búsqueda en Google</span>
                <span class="block text-violet-300 text-sm font-semibold mt-1">+ $45.000</span>
              </span>
            </label>
            
            <label for="mod-fotografia" class="mod-label flex items-start gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors has-checked:border-violet-500 has-checked:bg-violet-500/10">
              <input id="mod-fotografia" type="checkbox" class="mod-check accent-violet-500 w-5 h-5 mt-0.5 shrink-0" value="75000" data-name="Fotografía y copywriting" />
              <span class="text-sm text-slate-200">
                <span class="font-medium text-white">Fotografía y copywriting</span>
                <span class="block text-slate-400 text-xs mt-0.5">Textos y apoyo visual para tu sitio</span>
                <span class="block text-violet-300 text-sm font-semibold mt-1">+ $75.000</span>
              </span>
            </label>
            
            <label for="mod-dominio" class="mod-label flex items-start gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors has-checked:border-violet-500 has-checked:bg-violet-500/10">
              <input id="mod-dominio" type="checkbox" class="mod-check accent-violet-500 w-5 h-5 mt-0.5 shrink-0" value="35000" data-name="Dominio + correo corporativo" />
              <span class="text-sm text-slate-200">
                <span class="font-medium text-white">Dominio + correo corporativo</span>
                <span class="block text-slate-400 text-xs mt-0.5">Alta y configuración inicial (1 año ref.)</span>
                <span class="block text-violet-300 text-sm font-semibold mt-1">+ $35.000</span>
              </span>
            </label>
            
            <label for="mod-mantencion" class="mod-label flex items-start gap-3 p-4 rounded-xl bg-slate-800/40 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors has-checked:border-violet-500 has-checked:bg-violet-500/10">
              <input id="mod-mantencion" type="checkbox" class="mod-check accent-violet-500 w-5 h-5 mt-0.5 shrink-0" value="49000" data-name="Mantención mensual" />
              <span class="text-sm text-slate-200">
                <span class="font-medium text-white">Mantención mensual</span>
                <span class="block text-slate-400 text-xs mt-0.5">Cambios menores, respaldo y soporte continuo</span>
                <span class="block text-violet-300 text-sm font-semibold mt-1">+ $49.000 / mes</span>
              </span>
            </label>
          </div>
        </div>

        <!-- Resumen + CTA -->
        <div class="p-6 rounded-2xl bg-slate-950 border border-slate-800">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex-1 min-w-0">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Inversión Estimada (CLP)</span>
              <div id="total-price" class="text-4xl font-extrabold text-transparent bg-clip-text bg-linear-to-r from-violet-400 to-cyan-400 mt-1">
                $45.990 CLP
              </div>
              <p id="quote-summary" class="mt-2 text-sm text-slate-400 leading-relaxed">
                Promoción Pyme Sitio Web (Inicial $45.990 + $25.000/mes)
              </p>
            </div>
            <div class="flex flex-col gap-3 w-full md:w-auto shrink-0">
            <button
              type="button"
              id="send-quote"
              class="w-full md:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-[#25d366] hover:bg-[#20bd5a] text-white font-black text-base shadow-lg shadow-green-500/25 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-green-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
            >
              <svg class="w-5 h-5" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
                <path d="M16.001 2.002c-7.713 0-13.975 6.262-13.975 13.975 0 2.465.643 4.868 1.865 6.99L2 30l7.2-1.886a13.92 13.92 0 006.801 1.735h.006c7.713 0 13.975-6.262 13.975-13.975S23.714 2.002 16.001 2.002zm0 25.54a11.54 11.54 0 01-5.88-1.605l-.421-.25-4.42 1.158 1.18-4.31-.274-.442a11.55 11.55 0 01-1.777-6.116c0-6.38 5.193-11.573 11.574-11.573 6.38 0 11.573 5.193 11.573 11.573 0 6.381-5.193 11.565-11.555 11.565zm6.352-8.666c-.348-.174-2.06-1.016-2.38-1.132-.32-.116-.553-.174-.786.174-.233.348-.902 1.132-1.105 1.365-.203.233-.406.262-.754.087-.348-.174-1.47-.542-2.8-1.727-1.035-.923-1.734-2.062-1.937-2.41-.203-.348-.022-.536.152-.71.156-.155.348-.406.522-.61.174-.203.233-.348.348-.58.116-.233.058-.436-.029-.61-.087-.174-.786-1.894-1.077-2.595-.283-.68-.57-.588-.786-.6-.203-.01-.436-.012-.669-.012s-.61.087-.93.436c-.32.348-1.22 1.192-1.22 2.906s1.25 3.37 1.423 3.603c.174.233 2.46 3.757 5.96 5.267 2.21.953 3.077.87 3.64.813.552-.058 2.06-.842 2.35-1.655.29-.813.29-1.51.203-1.655-.087-.145-.32-.233-.669-.406z"/>
              </svg>
              Solicitar por WhatsApp
            </button>

            <button
              type="button"
              id="email-toggle"
              aria-expanded="false"
              aria-controls="quote-form-panel"
              class="w-full md:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl border-2 border-violet-500/60 bg-violet-500/10 hover:bg-violet-500/20 hover:border-violet-400 text-violet-100 font-black text-base transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 7l9 6 9-6" />
              </svg>
              Solicitar por correo
              <svg id="email-toggle-icon" class="w-4 h-4 transition-transform duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
              </svg>
            </button>
            </div>
          </div>

          <!-- Formulario de solicitud por correo (se despliega) -->
          <div id="quote-form-panel" class="quote-panel" data-open="false" inert aria-hidden="true">
            <div class="quote-panel-inner">
              <div class="mt-6 pt-6 border-t border-slate-800">
                <!-- Estado: formulario -->
                <div id="quote-form-view">
                  <div class="mb-5">
                    <h3 class="text-xl font-extrabold text-white">Cuéntanos de tu proyecto</h3>
                    <p class="mt-1 text-sm text-slate-400">
                      Completa tus datos y tu solicitud llegará a
                      <span class="font-semibold text-cyan-300">contacto@kadmiel.cl</span>.
                    </p>
                  </div>

                  <div class="mb-6 rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-3">
                    <span class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Tu selección</span>
                    <p id="form-selection" class="mt-0.5 text-sm text-slate-200">Promoción Pyme Sitio Web (Inicial $45.990 + $25.000/mes)</p>
                    <p id="form-total" class="text-sm font-bold text-violet-300 tabular-nums">$45.990 CLP</p>
                  </div>

                  <form id="quote-form" class="space-y-4" autocomplete="on" toolname="solicitar_cotizacion" tooldescription="Envía a Kadmiel una solicitud de cotización para desarrollar un sitio web, usando el tipo de proyecto y los módulos elegidos en la calculadora. Requiere nombre y correo de contacto.">
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                      <div>
                        <label for="qf-name" class="mb-1.5 block text-xs font-bold text-slate-300">Nombre <span class="text-rose-400" aria-hidden="true">*</span></label>
                        <input id="qf-name" name="name" toolparamdescription="Nombre completo de la persona que solicita la cotización" type="text" required minlength="2" maxlength="100" autocomplete="name" placeholder="Tu nombre" class="qf-input" />
                      </div>
                      <div>
                        <label for="qf-email" class="mb-1.5 block text-xs font-bold text-slate-300">Correo <span class="text-rose-400" aria-hidden="true">*</span></label>
                        <input id="qf-email" name="email" toolparamdescription="Correo electrónico donde Kadmiel enviará la propuesta" type="email" required maxlength="150" autocomplete="email" placeholder="tucorreo@empresa.cl" class="qf-input" />
                      </div>
                      <div>
                        <label for="qf-phone" class="mb-1.5 block text-xs font-bold text-slate-300">Teléfono <span class="font-normal text-slate-500">(opcional)</span></label>
                        <input id="qf-phone" name="phone" toolparamdescription="Teléfono o WhatsApp de contacto (opcional), formato +56 9 XXXX XXXX" type="tel" maxlength="30" autocomplete="tel" placeholder="+56 9 1234 5678" class="qf-input" />
                      </div>
                      <div>
                        <label for="qf-company" class="mb-1.5 block text-xs font-bold text-slate-300">Empresa o proyecto <span class="font-normal text-slate-500">(opcional)</span></label>
                        <input id="qf-company" name="company" toolparamdescription="Nombre de la empresa o negocio (opcional)" type="text" maxlength="120" autocomplete="organization" placeholder="Nombre de tu negocio" class="qf-input" />
                      </div>
                    </div>

                    <div>
                      <label for="qf-message" class="mb-1.5 block text-xs font-bold text-slate-300">Mensaje <span class="font-normal text-slate-500">(opcional)</span></label>
                      <textarea id="qf-message" name="message" toolparamdescription="Detalles del proyecto: rubro, secciones, plazos y sitios de referencia (opcional)" rows="4" maxlength="2000" placeholder="Cuéntanos qué necesitas, plazos, referencias de sitios que te gusten…" class="qf-input resize-y"></textarea>
                    </div>

                    <div class="qf-trap" aria-hidden="true">
                      <label for="qf-website">No completar este campo</label>
                      <input id="qf-website" name="website" toolparamdescription="Campo anti-spam: dejar siempre vacío" type="text" tabindex="-1" autocomplete="off" />
                    </div>

