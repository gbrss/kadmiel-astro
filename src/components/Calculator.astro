<script>
  // Carga diferida del script de la calculadora (Buena práctica)
  const calcSection = document.getElementById('cotizador');
  if (calcSection) {
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        import('../scripts/calculator.ts').then((module) => {
          module.initCalculator();
        });
        observer.disconnect();
      }
    }, { rootMargin: '400px' }); // Se carga 400px antes de llegar
    observer.observe(calcSection);
  }
</script>