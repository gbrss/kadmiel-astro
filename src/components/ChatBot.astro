---
// Chatbot flotante de Kadmiel: asistente de preguntas frecuentes (sin servicios externos).
// El panel se construye recién cuando el visitante abre el chat, así no suma peso ni
// trabajo al cargar la página (PageSpeed).
const phone = '56962206148';
---

<button
  type="button"
  id="kd-chat-toggle"
  class="kd-chat-float"
  aria-label="Abrir chat con Aurora, asistente de Kadmiel"
  aria-expanded="false"
  aria-controls="kd-chat-panel"
>
  <svg class="kd-icon kd-icon--chat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"/>
    <path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01" stroke-width="2.6"/>
  </svg>
  <svg class="kd-icon kd-icon--close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
    <path d="M6 6l12 12M18 6L6 18"/>
  </svg>
</button>

<div id="kd-chat-panel" class="kd-chat-panel" role="dialog" aria-label="Chat con Aurora" hidden data-phone={phone}></div>

<style>
  .kd-chat-float {
    position: fixed;
    bottom: 1.5rem;
    right: 6rem; /* a la izquierda del botón de WhatsApp (1.5rem + 3.75rem + separación) */
    z-index: 9999;
    width: 3.75rem;
    height: 3.75rem;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #7c3aed 0%, #6366f1 50%, #06b6d4 100%);
    box-shadow: 0 4px 20px rgba(124, 58, 237, 0.5);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .kd-chat-float:hover { transform: scale(1.1); box-shadow: 0 6px 28px rgba(99, 102, 241, 0.6); }
  .kd-chat-float:focus-visible { outline: 3px solid #a5f3fc; outline-offset: 3px; }
  .kd-icon { width: 1.7rem; height: 1.7rem; position: absolute; transition: opacity 0.2s ease, transform 0.25s ease; }
  .kd-icon--close { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  .kd-chat-float[aria-expanded='true'] .kd-icon--chat { opacity: 0; transform: rotate(90deg) scale(0.6); }
  .kd-chat-float[aria-expanded='true'] .kd-icon--close { opacity: 1; transform: none; }

  @media (max-width: 640px) {
    .kd-chat-float { bottom: 1.25rem; right: 5.5rem; width: 3.5rem; height: 3.5rem; }
  }

  .kd-chat-panel {
    position: fixed;
    right: 1.5rem;
    bottom: 6.25rem;
    z-index: 9998;
    width: min(23.5rem, calc(100vw - 2rem));
    height: min(34rem, calc(100dvh - 8.5rem));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgba(139, 92, 246, 0.45);
    background: #0b1120;
    color: #e2e8f0;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.65), 0 0 40px rgba(124, 58, 237, 0.18);
    transform-origin: bottom right;
    animation: kdIn 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .kd-chat-panel[hidden] { display: none; }
  @keyframes kdIn { from { opacity: 0; transform: translateY(12px) scale(0.96); } to { opacity: 1; transform: none; } }
  @media (max-width: 640px) {
    .kd-chat-panel { right: 1rem; bottom: 5.75rem; width: calc(100vw - 2rem); height: min(36rem, calc(100dvh - 7.5rem)); }
  }
</style>

<style is:global>
  .kd-head { display: flex; align-items: center; gap: 0.75rem; padding: 0.85rem 1rem; background: linear-gradient(135deg, #5b21b6, #4338ca 55%, #0e7490); color: #fff; }
  .kd-avatar { width: 2.25rem; height: 2.25rem; border-radius: 0.65rem; background: rgba(255, 255, 255, 0.18); display: grid; place-items: center; font-weight: 800; font-size: 0.85rem; flex: none; }
  .kd-head strong { display: block; font-size: 0.95rem; line-height: 1.2; }
  .kd-head small { display: flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; color: #d1fae5; }
  .kd-head small::before { content: ''; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #34d399; }
  .kd-x { margin-left: auto; border: 0; background: transparent; color: #fff; cursor: pointer; padding: 0.35rem; border-radius: 0.5rem; line-height: 0; }
  .kd-x:hover { background: rgba(255, 255, 255, 0.15); }
  .kd-x:focus-visible, .kd-chip:focus-visible, .kd-link:focus-visible, .kd-send:focus-visible, .kd-input:focus-visible { outline: 2px solid #67e8f9; outline-offset: 2px; }

  .kd-log { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.6rem; overscroll-behavior: contain; scroll-behavior: smooth; }
  .kd-msg { max-width: 88%; padding: 0.6rem 0.85rem; border-radius: 1rem; font-size: 0.875rem; line-height: 1.5; animation: kdMsg 0.25s ease-out; }
  .kd-msg p + p { margin-top: 0.45rem; }
  .kd-bot { align-self: flex-start; background: #172036; border: 1px solid #243049; border-bottom-left-radius: 0.3rem; }
  .kd-user { align-self: flex-end; background: linear-gradient(135deg, #6d28d9, #4f46e5); color: #fff; border-bottom-right-radius: 0.3rem; }
  @keyframes kdMsg { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .kd-price { width: 100%; border-collapse: collapse; margin-top: 0.4rem; font-size: 0.8rem; }
  .kd-price td { padding: 0.28rem 0; border-bottom: 1px solid #243049; }
  .kd-price td:last-child { text-align: right; font-weight: 700; color: #c4b5fd; white-space: nowrap; padding-left: 0.6rem; }
  .kd-price tr:last-child td { border-bottom: 0; }

  .kd-typing { display: inline-flex; gap: 0.25rem; align-items: center; padding: 0.2rem 0; }
  .kd-typing i { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: #94a3b8; animation: kdDot 1s infinite ease-in-out; }
  .kd-typing i:nth-child(2) { animation-delay: 0.15s; }
  .kd-typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes kdDot { 0%, 80%, 100% { opacity: 0.3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-3px); } }

  .kd-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; align-self: flex-start; max-width: 100%; }
  .kd-chip, .kd-link { font: inherit; font-size: 0.8rem; font-weight: 600; padding: 0.4rem 0.75rem; border-radius: 999px; cursor: pointer; text-decoration: none; transition: background 0.2s, border-color 0.2s; }
  .kd-chip { color: #c4b5fd; background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.45); }
  .kd-chip:hover { background: rgba(139, 92, 246, 0.22); }
  .kd-link { display: inline-block; color: #6ee7b7; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.45); }
  .kd-link:hover { background: rgba(16, 185, 129, 0.22); }
  .kd-links { display: flex; flex-wrap: wrap; gap: 0.4rem; align-self: flex-start; }

  .kd-form { display: flex; gap: 0.5rem; padding: 0.7rem; border-top: 1px solid #1e293b; background: #0b1120; }
  .kd-input { flex: 1; min-width: 0; font: inherit; font-size: 16px; padding: 0.55rem 0.8rem; border-radius: 0.75rem; border: 1px solid #334155; background: #111a2e; color: #f1f5f9; }
  .kd-input::placeholder { color: #94a3b8; }
  .kd-send { flex: none; width: 2.6rem; border: 0; border-radius: 0.75rem; cursor: pointer; color: #fff; background: linear-gradient(135deg, #7c3aed, #06b6d4); display: grid; place-items: center; }
  .kd-send:hover { filter: brightness(1.1); }
  .kd-foot { padding: 0 0.8rem 0.6rem; font-size: 0.7rem; color: #94a3b8; text-align: center; background: #0b1120; }

  @media (prefers-reduced-motion: reduce) {
    .kd-chat-panel, .kd-msg, .kd-typing i { animation: none !important; }
    .kd-log { scroll-behavior: auto; }
  }
</style>

