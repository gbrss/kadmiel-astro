  const QUOTE_LINK: Link = { label: 'Ir al cotizador', href: '#cotizador' };

  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9$.\s-]/g, ' ');

  const R: Record<string, Reply> = {
