      ],
      links: [{ label: 'Ver garantías', href: '#garantias' }],
      chips: ['Precios', 'Hablar con una persona'],
    },
    portafolio: {
      text: ['Hemos desarrollado sitios para minería, turismo, catálogos y otros rubros. Puede verlos en nuestro portafolio.'],
      links: [{ label: 'Ver portafolio', href: '#portafolio' }],
      chips: ['Precios', 'Hablar con una persona'],
    },
    landing: {
      text: ['Una Landing Page es una página enfocada en conversión; el valor referencial es desde $150.000. Si además busca posicionarse en su zona, la One-Page + SEO local parte en $180.000.', 'Y si quiere partir con la menor inversión, la Promoción Pyme es $45.990 de pago inicial + $25.000 al mes.'],
      links: [QUOTE_LINK],
      chips: ['Promoción Pyme', 'Plazos de entrega', 'Hablar con una persona'],
    },
    corporativo: {
      text: ['El Sitio Corporativo (hasta 5 secciones, con formulario y SEO base) parte en $250.000; con blog, en $320.000.', 'Si prefiere partir con algo más liviano, la Promoción Pyme es $45.990 de pago inicial + $25.000 al mes, con dominio por 1 año.'],
      links: [QUOTE_LINK],
      chips: ['Promoción Pyme', 'Plazos de entrega', 'Hablar con una persona'],
    },
    otro: {
      text: ['Cuénteme qué necesita (por ejemplo: reservas, un portal de clientes, SEO, redes sociales o un chatbot) y le oriento. También puede ver todos los valores o hablar con una persona del equipo.'],
      chips: ['Precios', 'Módulos adicionales', 'Promoción Pyme', 'Hablar con una persona'],
    },
    humano: {
      text: ['Con gusto. Una persona del equipo le responderá por WhatsApp, normalmente en menos de un día.'],
      links: [WA_LINK, { label: 'Escribir por correo', href: 'mailto:contacto@kadmiel.cl' }],
      chips: ['Precios'],
    },
    gracias: {
      text: ['¡De nada! Si necesita algo más, aquí estoy. — Aurora'],
      chips: MENU,
    },
    fallback: {
      text: ['Disculpe, no logré entender su consulta. Puede elegir una de estas opciones o hablar directamente con el equipo.'],
      links: [WA_LINK],
      chips: MENU,
    },
  };

  // Intención por palabras clave (el orden importa: lo más específico primero)
  const INTENTS: [string, RegExp][] = [
    ['quien', /\b(quien eres|como te llamas|tu nombre|cual es tu nombre|eres (un )?(robot|bot|humano|persona|real)|cuantos anos|que edad|tu edad)\b/],
    ['humano', /\b(humano|persona|ejecutiv|asesor|vendedor|whatsapp|wasap|llamar|telefono|contacto|correo electronico|email)\b/],
    ['promo', /\b(promo|pyme|oferta|45\.?990|barato|economic)/],
    ['modulos', /\b(modulo|adicional|extra)/],
    ['wordpress', /\b(wordpress|wix|migr)/],
    ['tienda', /\b(tienda|ecommerce|e-commerce|vender|venta|webpay|carrito|catalogo|pagos?)\b/],
    ['ia', /\b(chatbot|bot|ia|agente|automat|inteligencia)\b/],
    ['seo', /\b(seo|google|posicion|buscador|ranking)\b/],
    ['hosting', /\b(hosting|dominio|correo|mantencion|mantenimiento|soporte|servidor)\b/],
    ['velocidad', /\b(pagespeed|velocidad|rapid|lent|astro|carga)\b/],
    ['garantias', /\b(garantia|seguro|seguridad|confian)\b/],
    ['plazos', /\b(plazo|demora|tarda|tiempo|entrega|cuando|dias)\b/],
    ['proceso', /\b(proceso|como trabaj|etapas|pasos|metodolog)\b/],
    ['portafolio', /\b(portafolio|ejemplo|trabajos|proyectos|clientes)\b/],
    ['precios', /\b(precio|cuesta|costo|valor|cotiz|presupuesto|tarifa|cuanto|plan)\b/],
    ['landing', /\b(landing|one-?page|pagina de aterrizaje)\b/],
    ['corporativo', /\b(corporativ|empresa|institucional|sitio web|pagina web)\b/],
    ['gracias', /\b(gracias|muchas gracias|genial|perfecto|ok)\b/],
    ['welcome', /^(hola|holi|buenas|buenos dias|buenas tardes|buenas noches|hey|ola)\b/],
  ];

  // Texto de los botones rápidos -> intención
  const CHIP_TO_INTENT: Record<string, string> = {
    'Precios': 'precios',
    'Promoción Pyme': 'promo',
    'Plazos de entrega': 'plazos',
    'Migrar desde WordPress': 'wordpress',
    'Tienda online': 'tienda',
    'Hablar con una persona': 'humano',
    'Cómo trabajan': 'proceso',
    'Módulos adicionales': 'modulos',
    'Velocidad y PageSpeed': 'velocidad',
    'Garantías': 'garantias',
    'Landing Page': 'landing',
    'Sitio Corporativo': 'corporativo',
    'Otro servicio': 'otro',
  };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let built = false;
  let log: HTMLDivElement;
  let input: HTMLInputElement;
  let busy = false;

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text) n.textContent = text;
    return n;
  };
  const scroll = () => { log.scrollTop = log.scrollHeight; };

  function build() {
    built = true;
    const head = el('div', 'kd-head');
    head.append(el('span', 'kd-avatar', 'A'));
    const who = el('div');
    who.append(el('strong', '', 'Aurora'), el('small', '', 'Asistente de Kadmiel · En línea'));
    const x = el('button', 'kd-x') as HTMLButtonElement;
    x.type = 'button';
    x.setAttribute('aria-label', 'Cerrar chat');
    x.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>';
    x.addEventListener('click', () => close(true));
    head.append(who, x);

    log = el('div', 'kd-log') as HTMLDivElement;
    log.setAttribute('role', 'log');
    log.setAttribute('aria-live', 'polite');
    log.setAttribute('aria-label', 'Conversación');

    const form = el('form', 'kd-form') as HTMLFormElement;
    input = el('input', 'kd-input') as HTMLInputElement;
    input.type = 'text';
    input.placeholder = 'Escriba su consulta…';
    input.maxLength = 200;
    input.autocomplete = 'off';
    input.setAttribute('aria-label', 'Escriba su consulta');
    const send = el('button', 'kd-send') as HTMLButtonElement;
    send.type = 'submit';
    send.setAttribute('aria-label', 'Enviar');
    send.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>';
    form.append(input, send);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = input.value.trim();
      if (!v || busy) return;
      input.value = '';
      ask(v);
    });

    const foot = el('div', 'kd-foot', 'Aurora · Asistente virtual · Valores referenciales en CLP');
    panel.append(head, log, form, foot);
    reply('welcome', 0);
  }

  function addUser(text: string) {
    log.querySelectorAll('.kd-chips').forEach((c) => c.remove());
    log.append(el('div', 'kd-msg kd-user', text));
    scroll();
  }

  function render(r: Reply) {
    const msg = el('div', 'kd-msg kd-bot');
    (r.text || []).forEach((t) => msg.append(el('p', '', t)));
    if (r.rows) {
      const table = el('table', 'kd-price');
      r.rows.forEach(([a, b]) => {
        const tr = el('tr');
        tr.append(el('td', '', a), el('td', '', b));
        table.append(tr);
      });
      msg.append(table);
    }
    log.append(msg);
    if (r.links?.length) {
      const box = el('div', 'kd-links');
      r.links.forEach((l) => {
        const a = el('a', 'kd-link', l.label) as HTMLAnchorElement;
        a.href = l.href;
        if (l.href.startsWith('http')) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
        else if (l.href.startsWith('#')) a.addEventListener('click', () => close(false));
        box.append(a);
      });
      log.append(box);
    }
    if (r.chips?.length) {
      const box = el('div', 'kd-chips');
      r.chips.forEach((c) => {
        const b = el('button', 'kd-chip', c) as HTMLButtonElement;
        b.type = 'button';
        b.addEventListener('click', () => ask(c));
        box.append(b);
      });
      log.append(box);
    }
    scroll();
  }

  function reply(key: string, delay = 550) {
    busy = true;
    const typing = el('div', 'kd-msg kd-bot');
    const dots = el('span', 'kd-typing');
    dots.setAttribute('aria-label', 'Escribiendo');
    dots.append(el('i'), el('i'), el('i'));
    typing.append(dots);
    if (delay) { log.append(typing); scroll(); }
    window.setTimeout(() => {
      typing.remove();
      render(R[key] || R.fallback);
      busy = false;
    }, reduceMotion ? 0 : delay);
  }

  function ask(text: string) {
    if (busy) return;
    addUser(text);
    const key = CHIP_TO_INTENT[text] || (INTENTS.find(([, re]) => re.test(norm(text))) || ['fallback'])[0];
    reply(key);
  }

  function open() {
    if (!built) build();
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Cerrar chat');
    window.setTimeout(() => input?.focus({ preventScroll: true }), 50);
  }
  function close(returnFocus: boolean) {
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Abrir chat con Aurora, asistente de Kadmiel');
    if (returnFocus) toggle.focus();
  }

  toggle.addEventListener('click', () => (panel.hidden ? open() : close(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) close(true);
  });
</script>
