---
const stats = [
  {
    id: 'speed',
    type: 'count',
    target: 100,
    prefix: '',
    suffix: '/100',
    label: 'PageSpeed promedio',
    icon: 'gauge',
    delay: 0,
  },
  {
    id: 'load',
    type: 'static',
    display: '<0.8',
    suffix: 's',
    label: 'Tiempo de carga',
    icon: 'bolt',
    delay: 120,
  },
  {
    id: 'days',
    type: 'range',
    from: 7,
    to: 15,
    suffix: 'días',
    label: 'Plazo de entrega',
    icon: 'calendar',
    delay: 240,
  },
  {
    id: 'plugins',
    type: 'count',
    target: 0,
    prefix: '',
    suffix: ' plugins',
    label: 'Vulnerabilidades típicas',
    icon: 'shield',
    delay: 360,
  },
];

const painPoints = [
  {
    title: 'Tu web actual es lenta',
    desc: 'Cada segundo extra de carga puede bajar la conversión hasta un 20%. En móvil, el usuario se va.',
    icon: 'slow',
  },
  {
    title: 'Google no te posiciona',
    desc: 'Core Web Vitals bajos penalizan el ranking. Una web rápida es una ventaja competitiva real.',
    icon: 'search',
  },
  {
    title: 'WordPress se vuelve caro',
    desc: 'Plugins, hosting, actualizaciones y riesgos de seguridad suman costos y dolores de cabeza.',
    icon: 'wallet',
  },
];
---

<section class="py-20 bg-[#090d16] border-t border-slate-800/80 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Stats bar -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-16" id="stats-grid">
      {stats.map((s) => (
        <div
          class={`stat-card group relative rounded-2xl border border-slate-800/80 bg-slate-900/60 px-5 py-7 text-center backdrop-blur-sm overflow-hidden transition-all duration-500 hover:border-violet-500/40 hover:bg-slate-900/80 hover:shadow-lg hover:shadow-violet-500/10`}
          style={`animation-delay: ${s.delay}ms`}
          data-stat={s.id}
          data-type={s.type}
          data-target={s.type === 'count' ? s.target : undefined}
          data-from={s.type === 'range' ? s.from : undefined}
          data-to={s.type === 'range' ? s.to : undefined}
        >
          <!-- Glow sutil al hover -->
          <div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-[radial-gradient(ellipse_at_center,_rgba(139,92,246,0.12),_transparent_70%)]"></div>

          <!-- Icono animado -->
          <div class="stat-icon relative mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-violet-500/20 to-cyan-500/15 border border-violet-500/20 text-cyan-300">
            {s.icon === 'gauge' && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14a2 2 0 100-4 2 2 0 000 4z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l3-5"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.93 19.07A10 10 0 1119.07 4.93 10 10 0 014.93 19.07z"/>
              </svg>
            )}
            {s.icon === 'bolt' && (
              <svg class="w-6 h-6 icon-pulse" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13 2L4.5 13.5H11L10 22L19.5 9.5H13L13 2Z"/>
              </svg>
            )}
            {s.icon === 'calendar' && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="5" width="18" height="16" rx="2"/>
                <path stroke-linecap="round" d="M3 10h18M8 3v4M16 3v4"/>
              </svg>
            )}
            {s.icon === 'shield' && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-3z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/>
              </svg>
            )}
          </div>

          <div class="relative">
            <div class="text-2xl md:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-cyan-400 tabular-nums">
              {s.type === 'static' ? (
                <span>
                  {s.display}<span class="text-lg md:text-xl font-bold text-cyan-300/80">{s.suffix}</span>
                </span>
              ) : s.type === 'range' ? (
                <span>
                  <span data-num-from>0</span>–<span data-num-to>0</span>
                  <span class="text-lg md:text-xl font-bold text-cyan-300/80"> {s.suffix}</span>
                </span>
              ) : (
                <span>
                  <span data-num>0</span>
                  <span class="text-lg md:text-xl font-bold text-cyan-300/80">{s.suffix}</span>
                </span>
              )}
            </div>
            <p class="mt-1.5 text-xs md:text-sm text-slate-400 font-medium">{s.label}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Problema → solución -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-bold text-rose-400 tracking-widest uppercase mb-3">El costo de no actuar</h2>
      <p class="text-3xl md:text-4xl font-extrabold text-white leading-tight">
        Si tu sitio tarda más de 3 segundos, estás perdiendo ventas
      </p>
      <p class="mt-4 text-slate-400 text-base md:text-lg">
        No es solo “velocidad bonita”: es posicionamiento, confianza y conversión.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {painPoints.map((p) => (
        <div class="pain-card rounded-2xl border border-slate-800 bg-slate-900/40 p-6 hover:border-rose-500/30 transition-all duration-300 hover:-translate-y-1">
          <div class="w-11 h-11 rounded-xl bg-rose-500/15 text-rose-400 flex items-center justify-center mb-4">
            {p.icon === 'slow' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <path stroke-linecap="round" d="M12 7v5l3 2"/>
              </svg>
            )}
            {p.icon === 'search' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/>
                <path stroke-linecap="round" d="M20 20l-3-3"/>
                <path stroke-linecap="round" d="M8 11h6"/>
              </svg>
            )}
            {p.icon === 'wallet' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h16a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z"/>
                <path stroke-linecap="round" d="M3 8V6a2 2 0 012-2h12"/>
                <circle cx="16" cy="14" r="1.5" fill="currentColor"/>
              </svg>
            )}
          </div>
          <h3 class="text-lg font-bold text-white mb-2">{p.title}</h3>
          <p class="text-sm text-slate-400 leading-relaxed">{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Flotación suave escalonada */
  .stat-card {
    animation: floatIn 0.7s ease-out both, floatY 4.5s ease-in-out infinite;
  }
  .stat-card:nth-child(1) { animation-delay: 0ms, 0s; }
  .stat-card:nth-child(2) { animation-delay: 80ms, 0.6s; }
  .stat-card:nth-child(3) { animation-delay: 160ms, 1.2s; }
  .stat-card:nth-child(4) { animation-delay: 240ms, 1.8s; }

  @keyframes floatIn {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes floatY {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .stat-icon {
    animation: iconBob 3s ease-in-out infinite;
  }
  .stat-card:nth-child(2) .stat-icon { animation-delay: 0.4s; }
  .stat-card:nth-child(3) .stat-icon { animation-delay: 0.8s; }
  .stat-card:nth-child(4) .stat-icon { animation-delay: 1.2s; }

  @keyframes iconBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  .icon-pulse {
    animation: boltPulse 1.8s ease-in-out infinite;
  }
  @keyframes boltPulse {
    0%, 100% { opacity: 1; filter: drop-shadow(0 0 0 transparent); }
    50% { opacity: 0.85; filter: drop-shadow(0 0 6px rgba(34, 211, 238, 0.6)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-card,
    .stat-icon,
    .icon-pulse {
      animation: none !important;
    }
  }
</style>

<script>
  function easeOutCubic(t: number): number {
    return 1 - Math.pow(1 - t, 3);
  }

  function animateCount(
    el: HTMLElement,
    to: number,
    duration = 1400,
    onUpdate?: (n: number) => void
  ) {
    const start = performance.now();
    const from = 0;

    function frame(now: number) {
      const t = Math.min(1, (now - start) / duration);
      const value = Math.round(from + (to - from) * easeOutCubic(t));
      el.textContent = String(value);
      onUpdate?.(value);
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  function runStats() {
    const cards = document.querySelectorAll('.stat-card');
    cards.forEach((card) => {
      const type = card.getAttribute('data-type');
      if (type === 'count') {
        const target = parseInt(card.getAttribute('data-target') || '0', 10);
        const numEl = card.querySelector('[data-num]') as HTMLElement | null;
        if (numEl) animateCount(numEl, target, 1500);
      } else if (type === 'range') {
        const from = parseInt(card.getAttribute('data-from') || '0', 10);
        const to = parseInt(card.getAttribute('data-to') || '0', 10);
        const fromEl = card.querySelector('[data-num-from]') as HTMLElement | null;
        const toEl = card.querySelector('[data-num-to]') as HTMLElement | null;
        if (fromEl) animateCount(fromEl, from, 1200);
        if (toEl) animateCount(toEl, to, 1400);
      }
    });
  }

  // Solo animar cuando la sección entra en viewport
  const grid = document.getElementById('stats-grid');
  if (grid && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runStats();
            io.disconnect();
          }
        });
      },
      { threshold: 0.25 }
    );
    io.observe(grid);
  } else {
    runStats();
  }
</script>
