---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada | Kadmiel" description="La página que buscas no existe.">
  <main class="min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <p class="text-sm font-bold text-cyan-400 tracking-widest uppercase mb-3">Error 404</p>
    <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">Página no encontrada</h1>
    <p class="text-slate-400 mb-8">La dirección que buscas no existe o fue movida.</p>
    <a href="/" class="px-6 py-3 rounded-xl bg-linear-to-r from-violet-600 to-cyan-500 text-white font-bold">Volver al inicio</a>
  </main>
</Layout>
